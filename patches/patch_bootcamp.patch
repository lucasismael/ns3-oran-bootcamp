+					   << "plot \"lte-rem.out\" using ($1):($2):(10*log10($4)) with image"
+					   << std::endl;
+		lteGnuplotFile.close();
+
+		std::ofstream plotRemShFile;
+		plotRemShFile.open("plotRem.sh");
+		plotRemShFile << "gnuplot enbs.txt mmwave-rem--buildings.txt ues.txt mmwave-rem--plot-rem.gnuplot\n"
+					  << "gnuplot enbs.txt mmwave-rem--buildings.txt ues.txt lte-rem-plot.gnuplot"
+					  << std::endl;
+		plotRemShFile.close();
+
+		Ptr<MmWaveRadioEnvironmentMapHelper> remHelper = CreateObject<MmWaveRadioEnvironmentMapHelper>();
+
+		// if (buildingAreaMap)
+		// {
+		// 	remHelper->SetMinX(buildingBox.xMin);
+		// 	remHelper->SetMinY(buildingBox.yMin);
+		// 	remHelper->SetMaxX(buildingBox.xMax);
+		// 	remHelper->SetMaxY(buildingBox.yMax);
+		// 	remHelper->SetResX((buildingBox.xMax - buildingBox.xMin) / 2);
+		// 	remHelper->SetResY((buildingBox.yMax - buildingBox.yMin) / 2);
+		// }
+		// else
+		// {
+    remHelper->SetMinX(0);
+    remHelper->SetMinY(0);
+    // remHelper->SetMaxX(120);
+    remHelper->SetMaxX(250);
+    // remHelper->SetMaxY(50);
+    remHelper->SetMaxY(250);
+    remHelper->SetResX(100);
+    remHelper->SetResY(100);
+		// }
+
+		remHelper->SetInstallationDelay(Seconds(0.25));
+		remHelper->SetRemMode(MmWaveRadioEnvironmentMapHelper::COVERAGE_AREA);
+		// remHelper->SetRemMode(MmWaveRadioEnvironmentMapHelper::BEAM_SHAPE);
+		remHelper->CreateRem(mmWaveEnbDevs, mcUeDevs.Get(0), 0);
+
+		// Retrieving LTE channel
+		Ptr<LteEnbNetDevice> enbNetDev = DynamicCast<LteEnbNetDevice>(lteEnbDevs.Get(0)); // Retrieving the LteEnbNetDevice from the eNB
+		Ptr<LteEnbPhy> enbPhy = enbNetDev->GetPhy();									   // Retrieving the PHY layer from the eNB
+		Ptr<SpectrumChannel> enbDlChannel = enbPhy->GetDlSpectrumPhy()->GetChannel();
+		uint32_t lteChannelId = enbDlChannel->GetId();
+
+		// Checking if channel pointer is null
+		if (!enbDlChannel)
+		{
+			NS_FATAL_ERROR("LTE Channel cannot be null");
+		}
+
+		// Configuring REM
+		Ptr<RadioEnvironmentMapHelper> lteRemHelper = CreateObject<RadioEnvironmentMapHelper>();
+		lteRemHelper->SetAttribute("OutputFile", StringValue("lte-rem.out"));
+		lteRemHelper->SetAttribute("ChannelPath", StringValue("/ChannelList/" + std::to_string(lteChannelId)));
+		lteRemHelper->SetAttribute("XMin", DoubleValue(0.0));
+		lteRemHelper->SetAttribute("XMax", DoubleValue(500.0));
+		lteRemHelper->SetAttribute("YMin", DoubleValue(0.0));
+		lteRemHelper->SetAttribute("YMax", DoubleValue(500.0));
+		lteRemHelper->SetAttribute("XRes", UintegerValue(200));
+		lteRemHelper->SetAttribute("YRes", UintegerValue(200));
+		lteRemHelper->SetAttribute("Z", DoubleValue(1.5));
+		lteRemHelper->SetAttribute("StopWhenDone", BooleanValue(false));
+		lteRemHelper->SetAttribute("UseDataChannel", BooleanValue(false));
+		lteRemHelper->SetAttribute("Earfcn", UintegerValue(enbNetDev->GetDlEarfcn()));
+		lteRemHelper->SetAttribute("Bandwidth", UintegerValue(enbNetDev->GetDlBandwidth()));
+		lteRemHelper->Install();
+		Simulator::Run();
+		Simulator::Stop(Seconds(simTime));
+		return 0;
+	}
+
+  if (enableTraces)
+  {
+    mmwaveHelper->EnableTraces ();
+  }  
+
+  // trick to enable PHY traces for the LTE stack
+  Ptr<LteHelper> lteHelper = CreateObject<LteHelper> ();
+  lteHelper->Initialize ();
+  lteHelper->EnablePhyTraces ();
+  lteHelper->EnableMacTraces ();
+
+  // Since nodes are randomly allocated during each run we always need to print their positions
+  PrintGnuplottableUeListToFile ("ues.txt");
+  PrintGnuplottableEnbListToFile ("enbs.txt");
+
+  for (double t = 0; t <= simTime; t = t + 1)
+	{
+		Simulator::Schedule(Seconds(t), &RegisterSimulationTime, t);
+	}
+
+  // Defining the stopTime
+	Simulator::Stop(Seconds(simTime + 0.001));
+
+  // Running and destroying the simulator
+	RunSimulationWithTimeCounter();
+
+  return 0;
+
+
+
+  
+}
