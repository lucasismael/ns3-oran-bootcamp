+import os
+import random
+import subprocess
+import multiprocessing
+import itertools
+import time
+from tqdm import tqdm
+
+# ---------------------------------------------------------
+# 1. Configurações da Campanha Local
+# ---------------------------------------------------------
+BASE_DIR = "/home/ns3master/ns333-master-dev"
+CAMPAIGN_NAME = "campanha_MAB_teste30"
+
+num_jobs = 2 
+max_workers = 10 
+
+# ---------------------------------------------------------
+# 2. Parâmetros da Simulação (ns-3)
+# ---------------------------------------------------------
+PARAMS = {
+    "enableE2FileLogging": ["true"],
+    "reducedPmValues": ["false"],
+    "plotMap": ["false"],
+    "simTime": [45],
+    "useMab": ["true"],
+    "dataRateMbb": [8.0],
+    "dataRateXr": [30.0],
+    "simSplitRatio": [1.0],
+    "nUesMixed": [12,13,14], 
+    "nUesBackground": [10],
+    "mabEpsilon": [1.0],               # Mantido fixo
+    "mabDecayFactor": [0.95], # Rápido, Médio, Lento
+    "mabAlpha": [0.9],       # Conservador, Equilibrado, Agressivo
+    "mabInterval": [0.1],   # 100ms, 300ms, 500ms
+    "simScenario": ["Step"]
+}
+
+# ---------------------------------------------------------
+# 3. Geração das Tarefas e Diretórios
+# ---------------------------------------------------------
+def run_simulation(cmd_base):
+    """Função worker para executar um único comando. Retorna (Status, Mensagem, Comando)."""
+    
+    worker_id = multiprocessing.current_process()._identity[0]
+    core_id = (worker_id - 1) % max_workers
+    cmd_with_taskset = f"taskset -c {core_id} {cmd_base}"
+    
+    time.sleep(15)
+    
+    start_time = time.time() # Inicia o cronômetro
+    
+    try:
+        subprocess.run(cmd_with_taskset, shell=True, check=True, cwd=BASE_DIR, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        end_time = time.time() # Para o cronômetro
+        duracao = end_time - start_time
+        
+        msg = f"SUCESSO [Core {core_id}] ({duracao:.2f}s): {cmd_base.split('--cwd')[0].strip()}"
+        return (True, msg, cmd_base)
+        
+    except subprocess.CalledProcessError as e:
+        end_time = time.time()
+        duracao = end_time - start_time
+        
+        msg = f"ERRO ({e.returncode}) [Core {core_id}] ({duracao:.2f}s): {cmd_base.split('--cwd')[0].strip()}"
+        return (False, msg, cmd_base)
+
+if __name__ == "__main__":
+    print(f"Gerando campanha local: {CAMPAIGN_NAME}...")
+
+    keys, values = zip(*PARAMS.items())
+    combinations = [dict(zip(keys, v)) for v in itertools.product(*values)]
+
+    commands_list = []
+    
+    sementes_sorteadas = random.sample(range(1, 1000000), num_jobs)
+    #sementes_sorteadas = [609382]
+    print(f"Sementes sorteadas para os {num_jobs} JOBs: {sementes_sorteadas}\n")
+
+    for job_idx in range(1, num_jobs + 1):
+        rng_run = sementes_sorteadas[job_idx - 1]
+        job_dir_name = f"JOB_{job_idx}"
+        
+        for config in combinations:
+            varied_params = [f"{k}_{config[k]}" for k, v in PARAMS.items() if len(v) > 1]
+            
+            if not varied_params:
+                sim_dir_name = "SIM_" + "_".join(varied_params) + f"_nUesMixed_{config['nUesMixed']}"
+            else:
+                #sim_dir_name = "SIM_" + "_".join(varied_params) + f"_nUesMixed_{config['nUesMixed']}"
+                sim_dir_name = "SIM_" + "_".join(varied_params)
+                
+            out_dir = os.path.join(f"{BASE_DIR}/outputs", CAMPAIGN_NAME, job_dir_name, sim_dir_name)
+            os.makedirs(out_dir, exist_ok=True)
+            
+            ns3_args = []
+            for k, v in config.items():
+                ns3_args.append(f"--{k}={v}")
+            
+            ns3_args.append(f"--rngRun={rng_run}")
+            ns3_args_str = " ".join(ns3_args)
+            
+            cmd_base = (
+                f"./waf --run \"scratch/scenario-master "
+                f"{ns3_args_str}\" --cwd={out_dir}"
+            )
+            commands_list.append(cmd_base)
+
+    print(f"Criadas {len(commands_list)} tarefas de simulação.")
+    print(f"Iniciando execução em paralelo isolada em {max_workers} cores físicos...\n")
+
+    # ---------------------------------------------------------
+    # 4. Execução Paralela com Mecanismo de Re-simulação
+    # ---------------------------------------------------------
+    comandos_pendentes = commands_list
+    relatorio_final = []
+    tentativa = 1
+
+    while comandos_pendentes:
+        if tentativa > 1:
+            print(f"\n=== Iniciando Tentativa {tentativa} para {len(comandos_pendentes)} simulações que falharam ===")
+            
+        resultados = []
+        with multiprocessing.Pool(processes=max_workers) as pool:
