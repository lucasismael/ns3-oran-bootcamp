+void MmWaveRadioEnvironmentMapHelper::ConfigureRrd (const Ptr<NetDevice> &rrdDevice)
+{
+  NS_LOG_FUNCTION (this);
+  // RTD and RRD devices should have the same spectrum model to perform calculation,
+  // if some of the RTD devices is of the different model then its transmission will have to
+  // converted into spectrum model of this device
+
+  Ptr<MmWaveEnbNetDevice> gnbRrdNetDevice=(rrdDevice)->GetObject<MmWaveEnbNetDevice> ();
+  Ptr<McUeNetDevice> ueRrdNetDevice=(rrdDevice)->GetObject<McUeNetDevice> ();
+
+  if (gnbRrdNetDevice)
+  {
+    std::cout <<"gnb is RRD (receiver)" << std::endl;
+    m_rrdPhy = gnbRrdNetDevice->GetPhy (m_ccId);
+    m_rrd.antenna = Copy (gnbRrdNetDevice->GetAntenna (m_ccId));
+    m_isDl=false; 
+  }
+  else if (ueRrdNetDevice)
+  {
+    std::cout << "ue is RRD (receiver)" << std::endl;
+    m_rrdPhy = ueRrdNetDevice->GetMmWavePhy (m_ccId);
+    m_rrd.antenna = Copy (ueRrdNetDevice->GetAntenna (m_ccId));
+    m_isDl=true; 
+  }
+  else
+  {
+    NS_FATAL_ERROR ("no RRD device!");
+  }
+
+  // Set the MmWavePhyMacCommom of the rrd
+  m_rrd.configParam = m_rrdPhy->GetConfigurationParameters();
+  // Set the SpectrumModel of the rrd
+  m_rrd.spectrumModel=MmWaveSpectrumValueHelper::GetSpectrumModel(m_rrd.configParam);
+  // Set the position of the m_rrd 
+  m_rrd.mob->SetPosition (rrdDevice->GetNode ()->GetObject<MobilityModel> ()->GetPosition ());
+
+  // Print the position of the UEs
+  std::ostringstream oss;
+  oss << "mmwave-rem-" << m_simTag.c_str() << "-ues.txt";
+  PrintGnuplottableUeListToFile (oss.str ());
+
+  // Aggregate the MobilityBuildingInfo to the mobility model of the m_rrd
+  Ptr<MobilityBuildingInfo> buildingInfo = CreateObject<MobilityBuildingInfo> ();
+  m_rrd.mob->AggregateObject (buildingInfo);
+
+  // Set the antenna of the m_rrd
+  //m_rrd.antenna=m_deviceToAntenna.at(rrdDevice->GetNode()->GetId());
+  //m_rrd.antenna = m_deviceToAntenna.find (rrdDevice)->second;
+  //m_rrd.antenna = m_deviceToAntenna.find (rrdDevice->GetNode()->GetId())->second;
+  //m_rrd.antenna=rrdDevice->GetAntenna(m_ccId);
+
+  // Calculate the noise psd
+  m_noisePsd = MmWaveSpectrumValueHelper::CreateNoisePowerSpectralDensity (m_rrdPhy->GetNoiseFigure (), m_rrd.spectrumModel);
+
+  // Set the object factories that will copy the propagation model. We can call only once configuration of prop.models. 
+  //This function might be a source of error, verify later.
+  Ptr<MmWaveSpectrumPhy> rrdSpectrumPhy;
+  if(m_isDl){
+    Ptr<MmWaveUePhy> uePhy=DynamicCast<MmWaveUePhy>(m_rrdPhy);
+    rrdSpectrumPhy=uePhy->GetDlSpectrumPhy();
+  }else{
+    Ptr<MmWaveEnbPhy> enbPhy=DynamicCast<MmWaveEnbPhy>(m_rrdPhy);
+    rrdSpectrumPhy=enbPhy->GetUlSpectrumPhy();
+  }
+  ConfigurePropagationModelsFactories(rrdSpectrumPhy);
+
+  // Configure a new MmWaveBeamforlingModel factory with the same type id as the one in m_rrd.
+  // This ObjectFactory will be used to create all bfModels in this class.
+  TypeId bfModelTypeId;
+  Ptr<MmWaveDftBeamforming> dftBfModel=DynamicCast<MmWaveDftBeamforming> (rrdSpectrumPhy->GetBeamformingModel());
+  Ptr<MmWaveSvdBeamforming> svdBfModel=DynamicCast<MmWaveSvdBeamforming> (rrdSpectrumPhy->GetBeamformingModel());
+  if(dftBfModel){
+    bfModelTypeId=dftBfModel->GetTypeId();
+  }else if(svdBfModel){
+    bfModelTypeId=svdBfModel->GetTypeId();
+  }else{
+    NS_FATAL_ERROR("The rrd device uses an unknown beamforming model.");
+  }
+  m_mmwaveBeamformingModelFactory.SetTypeId (bfModelTypeId);
+
+  // Use the m_mmwaveBeamformingModelFactory to create a new MmWaveBeamformingModel for the m_rrd
+  m_rrd.bfModel = DynamicCast<MmWaveBeamformingModel> (m_mmwaveBeamformingModelFactory.Create());
+  m_rrd.bfModel->SetDevice(m_rrd.dev);
+  m_rrd.bfModel->SetAntenna(m_rrd.antenna);
+  
+}
