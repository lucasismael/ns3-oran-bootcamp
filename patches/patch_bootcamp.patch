+   * @param l3RrcMeasurementServing  L3-filtered RRC measurement value for the
+   *                                 serving cell (RSRP in dBm, scaled per
+   *                                 TS 36.331).
+   */
+  void AddCuCpUePmItem (std::string ueImsiComplete, long numDrb, long l3RrcMeasurementServing);
 
 private:
 };
 
 } // namespace ns3
 
