+{
+    NS_LOG_FUNCTION(this);
+    m_ueRrcMean.push_back(m_rrc->GetUeMap().size());
+
+    // We register this every 10 ms
+    Simulator::Schedule(MilliSeconds(10), &MmWaveEnbNetDevice::SaveActiveUes, this);
