+
+namespace ns3 {
+
+UdpPoissonServerHelper::UdpPoissonServerHelper ()
+{
+  m_factory.SetTypeId (UdpPoissonServer::GetTypeId ());
+}
+
+UdpPoissonServerHelper::UdpPoissonServerHelper (uint16_t port)
+{
+  m_factory.SetTypeId (UdpPoissonServer::GetTypeId ());
+  SetAttribute ("Port", UintegerValue (port));
+}
+
+void
+UdpPoissonServerHelper::SetAttribute (std::string name, const AttributeValue &value)
+{
+  m_factory.Set (name, value);
+}
+
+ApplicationContainer
+UdpPoissonServerHelper::Install (NodeContainer c)
+{
+  ApplicationContainer apps;
+  for (NodeContainer::Iterator i = c.Begin (); i != c.End (); ++i)
+    {
+      Ptr<Node> node = *i;
+
+      m_server = m_factory.Create<UdpPoissonServer> ();
+      node->AddApplication (m_server);
+      apps.Add (m_server);
+
+    }
+  return apps;
+}
+
+Ptr<UdpPoissonServer>
+UdpPoissonServerHelper::GetServer (void)
+{
+  return m_server;
+}
+
+UdpPoissonClientHelper::UdpPoissonClientHelper ()
+{
+  m_factory.SetTypeId (UdpPoissonClient::GetTypeId ());
+}
+
+UdpPoissonClientHelper::UdpPoissonClientHelper (Address address, uint16_t port)
+{
+  m_factory.SetTypeId (UdpPoissonClient::GetTypeId ());
+  SetAttribute ("RemoteAddress", AddressValue (address));
+  SetAttribute ("RemotePort", UintegerValue (port));
+}
+
+UdpPoissonClientHelper::UdpPoissonClientHelper (Address address)
+{
+  m_factory.SetTypeId (UdpPoissonClient::GetTypeId ());
+  SetAttribute ("RemoteAddress", AddressValue (address));
+}
+
+void
+UdpPoissonClientHelper::SetAttribute (std::string name, const AttributeValue &value)
+{
+  m_factory.Set (name, value);
+}
+
+ApplicationContainer
+UdpPoissonClientHelper::Install (NodeContainer c)
+{
+  ApplicationContainer apps;
+  for (NodeContainer::Iterator i = c.Begin (); i != c.End (); ++i)
+    {
+      Ptr<Node> node = *i;
+      Ptr<UdpPoissonClient> client = m_factory.Create<UdpPoissonClient> ();
+      node->AddApplication (client);
+      apps.Add (client);
+    }
+  return apps;
+}
+
+UdpTracePoissonClientHelper::UdpTracePoissonClientHelper ()
+{
+  m_factory.SetTypeId (UdpTraceClient::GetTypeId ());
+}
+
+UdpTracePoissonClientHelper::UdpTracePoissonClientHelper (Address address, uint16_t port, std::string filename)
+{
+  m_factory.SetTypeId (UdpTraceClient::GetTypeId ());
+  SetAttribute ("RemoteAddress", AddressValue (address));
+  SetAttribute ("RemotePort", UintegerValue (port));
+  SetAttribute ("TraceFilename", StringValue (filename));
+}
+
+UdpTracePoissonClientHelper::UdpTracePoissonClientHelper (Address address, std::string filename)
+{
+  m_factory.SetTypeId (UdpTraceClient::GetTypeId ());
+  SetAttribute ("RemoteAddress", AddressValue (address));
+  SetAttribute ("TraceFilename", StringValue (filename));
+}
+
+void
+UdpTracePoissonClientHelper::SetAttribute (std::string name, const AttributeValue &value)
+{
+  m_factory.Set (name, value);
+}
+
+ApplicationContainer
+UdpTracePoissonClientHelper::Install (NodeContainer c)
+{
+  ApplicationContainer apps;
+  for (NodeContainer::Iterator i = c.Begin (); i != c.End (); ++i)
+    {
+      Ptr<Node> node = *i;
+      Ptr<UdpTraceClient> client = m_factory.Create<UdpTraceClient> ();
+      node->AddApplication (client);
+      apps.Add (client);
+    }
+  return apps;
+}
