+void MmWaveMcRadioEnvironmentMapHelper::CreateListOfRemPoints(){
+	NS_LOG_FUNCTION (this);
+	// Storing the position of the RTDs to make the comparison easier
+	std::list<Vector> rtdPosList; 
+	for(auto it:m_rtd){
+		Vector pos=it.mob->GetPosition();
+		pos.z=m_z;
+		rtdPosList.push_back(pos);
+	}
+	
+	
+	for (double x=m_xMin; x<=m_xMax; x+=m_xStep){
+		for (double y=m_yMin; y<=m_yMax; y+=m_yStep){
+			RemPoint remPoint;
+			remPoint.pos={x,y,m_z};
+			
+			// Check if it has the same position of the remPoint
+			bool isRtdPos=false;
+			for (auto it: rtdPosList){
+				if(it==remPoint.pos){
+					isRtdPos=true;
+					std::cout<<remPoint.pos<<std::endl;
+				}
+			}
+			
+			if(!isRtdPos){
+				m_rem.push_back (remPoint);
+			}
+		}
+	}
+}
+void MmWaveMcRadioEnvironmentMapHelper::ConfigureMmWaveRemDevices(){
+	NS_LOG_FUNCTION (this);
+	
+	// Configuring the RRD MmWaveRemDevice
+	m_rrd.DelayedConfiguration(m_bfModelFactory);
+	NS_LOG_INFO ("New RRD-> device type: "<<m_rrd.type);
+	
+	std::list<MmWaveRemDevice> rtd;
+	// Configuring the RTD MmWaveRemDevices
+	for(auto it:m_rtd){
+		it.DelayedConfiguration(m_bfModelFactory);
+		NS_LOG_INFO ("New RTD-> device type: "<<it.type);
+		rtd.push_back(it);
+	}
+	m_rtd=rtd;
+}
+
+void MmWaveMcRadioEnvironmentMapHelper::Install(NetDeviceContainer rtdDevices, Ptr<NetDevice> rrdDevice){
+	NS_LOG_FUNCTION (this);
+	
+	// Create the RRD MmWaveRemDevice
+	//MmWaveRemDevice rrd(rrdDevice);
+	m_rrd.CreateMmWaveRemDevice(rrdDevice);
+	
+	// Create the RTD MmWaveRemDevices
+	for(auto it = rtdDevices.Begin ();it != rtdDevices.End (); ++it){
+		MmWaveRemDevice rtd;
+		rtd.CreateMmWaveRemDevice(*it);
+		m_rtd.push_back(rtd);
+	}
+	
+	// Create the RemPoint List
+	CreateListOfRemPoints();
+	
+	// Schedule the next procedures
+	Simulator::Schedule (Seconds(1), &MmWaveMcRadioEnvironmentMapHelper::DelayedInstall, this);
+	
+	// Set the new simTime and run the simulator again
+	Simulator::Stop (Seconds (1.1));
+	Simulator::Run();
+	
+
+}
