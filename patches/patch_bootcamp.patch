+void
+MmWaveMcRadioEnvironmentMapHelper::PrintRemToFile ()
+{
+	NS_LOG_FUNCTION (this);
+
+	if(m_simTag!=""){
+		m_simTag="-"+m_simTag;
+	}
+	
+	
+	// Create one Ostringstream for the file
+	std::ostringstream oss_out; // Ostringstream of the .out file
+	oss_out << "mmwave-rem" << m_simTag.c_str() <<".out";
+
+
+	std::ofstream outFile;
+	outFile.open (oss_out.str ());
+
+	if (!outFile.is_open ()){
+		NS_FATAL_ERROR ("Can't open file " << (oss_out.str ()));
+		return;
+	}
+
+	for (auto it:m_rem){
+		outFile <<	it.pos.x << "\t" <<
+					it.pos.y << "\t" <<
+					it.pos.z << "\t" <<
+					it.avgSnrDb << "\t" <<
+					it.avgSinrDb ;
+		for(uint16_t i=0;i<m_rtd.size(); ++i){
+			outFile <<	"\t" << it.avgSnrPerRtd[i] <<
+						"\t" << it.avgSinrPerRtd[i];
+		}
+		outFile << std::endl;
+	}
+
+	outFile.close();
+	
+	CreateGnuplot("snr","SNR (dB)",4, false);
+	CreateGnuplot("sinr","SINR (dB)",5);
+	
+	for(int i=0;i<int(m_rtd.size()); ++i){
+		std::string rtdName="rtd-"+std::to_string(i);
+		CreateGnuplot("snr-"+rtdName,"SNR (dB)",2*i+6);
+		CreateGnuplot("sinr-"+rtdName,"SINR (dB)",2*i+7);
+	}
+	
+}
+
+void MmWaveMcRadioEnvironmentMapHelper::CreateGnuplot(std::string plotName,std::string cbLabel, int dataColNum, bool append, std::string cbRange){
+	// Create the osdtringstream of the gnuplot file
+	std::ostringstream oss_gnu; 
+	oss_gnu << "mmwave-rem" << m_simTag.c_str () << "-plot-rem.gnuplot";
+	
+	// Open the outputFile
+	std::ofstream outFile;
+	if(append){
+		outFile.open (oss_gnu.str (), std::ios_base::app);
+	}else{
+		outFile.open (oss_gnu.str (), std::ios_base::out | std::ios_base::trunc);
+	}
+	
+	if (!outFile.is_open ()){
+		NS_LOG_ERROR ("Can't open file " << oss_gnu.str ());
+		return;
+	}
+	
+	outFile << "set xlabel \"x-coordinate (m)\"" << std::endl;
+	outFile << "set ylabel \"y-coordinate (m)\"" << std::endl;
+	outFile << "set cblabel \""<< cbLabel <<"\""<< std::endl;
+	outFile << "set cblabel offset 3" << std::endl;
+	outFile << "unset key" << std::endl;
+	outFile << "set terminal png" << std::endl;
+	outFile << "set output \"mmwave-rem" << m_simTag << "-"<< plotName<<".png\"" << std::endl;
+	outFile << "set size ratio -1" << std::endl;
+	if(cbRange!=""){
+		outFile << "set cbrange "<< cbRange <<std::endl;
+	}
+	outFile << "set xrange [" << m_xMin << ":" << m_xMax << "]" << std::endl;
+	outFile << "set yrange [" << m_yMin << ":" << m_yMax << "]" << std::endl;
+	outFile << "set xtics font \"Ubuntu,17\"" << std::endl;
+	outFile << "set ytics font \"Ubuntu,17\"" << std::endl;
+	outFile << "set cbtics font \"Ubuntu,17\"" << std::endl;
+	outFile << "set xlabel font \"Ubuntu,17\"" << std::endl;
+	outFile << "set ylabel font \"Ubuntu,17\"" << std::endl;
+	outFile << "set cblabel font \"Ubuntu,17\"" << std::endl;
+	outFile << "plot \"mmwave-rem" << m_simTag << ".out\" using ($1):($2):($"<<dataColNum<<") with image" << std::endl;
+	
+	outFile.close ();
+	
+	NS_LOG_INFO ("Gnuplot script for " << "\"mmwave-rem" << m_simTag << "-"<< plotName<<".png\" " <<" created");
+	
+}
