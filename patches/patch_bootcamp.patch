+void
+LteEnbNetDevice::ControlMessageReceivedCallback(E2AP_PDU_t* sub_req_pdu)
+{
+    NS_LOG_UNCOND("LteEnbNetDevice::ControlMessageReceivedCallback: Received RIC Control Message");
+    // std::cout << "LteEnbNetDevice::ControlMessageReceivedCallback: Received RIC Control Message" << std::endl;
+
+    Ptr<RicControlMessage> controlMessage = Create<RicControlMessage>(sub_req_pdu);
+    NS_LOG_UNCOND("After RicControlMessage::RicControlMessage constructor");
+    NS_LOG_UNCOND("Request type " << controlMessage->m_requestType);
+    // std::cout << "Request type " << controlMessage->m_requestType << std::endl;
+    switch (controlMessage->m_requestType)
+    {
+    case RicControlMessage::ControlMessageRequestIdType::TS: {
+        NS_LOG_UNCOND("TS, do the handover");
+        // std::cout << "ControlMessageRequestIdType::TS" << std::endl;
+        // do handover
+        Ptr<OctetString> imsiString =
+            Create<OctetString>((void*)controlMessage->m_e2SmRcControlHeaderFormat1->ueId.buf,
+                                controlMessage->m_e2SmRcControlHeaderFormat1->ueId.size);
+        char* end;
+
+        uint64_t imsi = std::strtoull(imsiString->DecodeContent().c_str(), &end, 10);
+        uint16_t targetCellId = std::stoi(controlMessage->GetSecondaryCellIdHO());
+        NS_LOG_UNCOND("Imsi Decoded: " << imsi);
+        NS_LOG_UNCOND("Target Cell id " << targetCellId);
+        m_rrc->TakeUeHoControl(imsi);
+        if (!m_forceE2FileLogging)
+        {
+            Simulator::ScheduleWithContext(1,
+                                           Seconds(0),
+                                           &LteEnbRrc::PerformHandoverToTargetCell,
+                                           m_rrc,
+                                           imsi,
+                                           targetCellId);
         }
-      else
+        else
         {
-          NS_FATAL_ERROR (
-              "Unknown use case not implemented yet with filename: " << m_controlFilename);
+            Simulator::Schedule(Seconds(0),
+                                &LteEnbRrc::PerformHandoverToTargetCell,
+                                m_rrc,
+                                imsi,
+                                targetCellId);
+        }
+        break;
+    }
+    case RicControlMessage::ControlMessageRequestIdType::QoS: {
+        NS_LOG_UNCOND("ControlMessageRequestIdType::QoS (Processing DRB Split)");
+
+        Ptr<OctetString> imsiString =
+            Create<OctetString>((void*)controlMessage->m_e2SmRcControlHeaderFormat1->ueId.buf,
+                                controlMessage->m_e2SmRcControlHeaderFormat1->ueId.size);
+        char* end;
+        uint64_t imsi = std::strtoull(imsiString->DecodeContent().c_str(), &end, 10);
+        NS_LOG_UNCOND("Imsi Decoded: " << imsi);
+
+        // E2SM_RC_ControlMessage_Format1_t* rcFormat1 = controlMessage->m_e2SmRcControlMessageFormat1;
+        NS_LOG_UNCOND("DRB ID = " << controlMessage->m_drbId);
+        NS_LOG_UNCOND("SPLIT RATIO = " << controlMessage->m_drbSplitRatio);
+        long drbID = controlMessage->m_drbId;
+        long splitRatio = controlMessage->m_drbSplitRatio;
+
+        if (drbID != -1 && splitRatio != -1){
+            NS_LOG_UNCOND("Received DRB Split Control: DRB ID = " << drbID << ", Split Ratio = " << splitRatio << "%");
+            double ratio = (double)splitRatio / 100.0;
+            SetUeQoS(imsi, (uint16_t)drbID, ratio);
+        } else {
+            NS_LOG_ERROR("Failed to decode DRB ID or Split Ratio from Control Message");
         }
+        // SetUeQoS(imsi, drbID, splitRatio);
+        // NS_FATAL_ERROR("For QoS use file-based control.");
+        break;
+    }
+    default: {
+        NS_LOG_UNCOND("Unrecognized id type of Ric Control Mesage");
+        NS_LOG_ERROR("Unrecognized id type of Ric Control Message");
+        break;
+    }
+    }
+}
