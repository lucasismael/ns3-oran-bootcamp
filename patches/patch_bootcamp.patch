+/**
+ * @brief Dynamically changes the offered data rate for both traffic classes
+ *        and resets the MAB agent to adapt to the new traffic regime.
+ *
+ * This function is scheduled at specific simulation times (see "Step" and
+ * "Robustness" scenario configurations in main()) to simulate non-stationary
+ * traffic conditions.  It performs three operations:
+ *   1. Updates the OnOffApplication data rate for all eMBB sources to
+ *      @p newDataRateMbbMbps [Mib/s].
+ *   2. Updates the OnOffApplication data rate for all XR sources to
+ *      @p newDataRateXrMbps [Mib/s].
+ *   3. Resets the MAB agent (g_centralizedAgent) with a refreshed epsilon
+ *      and updated QoS targets (set at 90 % of the new offered loads):
+ *        - targetMbb = newDataRateMbbMbps × 1e3 × 0.90  [kbps]
+ *        - targetXr  = newDataRateXrMbps  × 1e3 × 0.90  [kbps]
+ *
+ * The new targets are also published to a Redis instance so that any
+ * running xApp can read the updated thresholds via the O-RAN interface.
+ *
+ * @param appsMbb           Container of eMBB OnOffApplication sources (QCI 2).
+ * @param appsXr            Container of XR  OnOffApplication sources (QCI 80).
+ * @param newDataRateMbbMbps New offered load for eMBB traffic [Mib/s].
+ * @param newDataRateXrMbps  New offered load for XR  traffic [Mib/s].
+ * @param resetEpsilon       Exploration rate ε to restore in the MAB agent.
+ */
+void ChangeDataRate(ApplicationContainer appsMbb, ApplicationContainer appsXr,
+                    double newDataRateMbbMbps, double newDataRateXrMbps, double resetEpsilon)
+{
+    DataRate newDataRateMbb(std::to_string(newDataRateMbbMbps) + "Mib/s");
+    DataRate newDataRateXr (std::to_string(newDataRateXrMbps)  + "Mib/s");
+
+    for (uint32_t i = 0; i < appsMbb.GetN(); ++i)
+    {
+        Ptr<Application> app = appsMbb.Get(i);
+        Ptr<OnOffApplication> onOffApp = DynamicCast<OnOffApplication>(app);
+        if (onOffApp)
+        {
+            onOffApp->SetAttribute("DataRate", DataRateValue(newDataRateMbb));
+        }
+    }
+
+    for (uint32_t i = 0; i < appsXr.GetN(); ++i)
+    {
+        Ptr<Application> app = appsXr.Get(i);
+        Ptr<OnOffApplication> onOffApp = DynamicCast<OnOffApplication>(app);
+        if (onOffApp)
+        {
+            onOffApp->SetAttribute("DataRate", DataRateValue(newDataRateXr));
+        }
+    }
+
+    // QoS targets are set at 90 % of the new offered load (kbps)
+    double newTargetMbb = (newDataRateMbbMbps * 1e3) * 0.90;
+    double newTargetXr  = (newDataRateXrMbps  * 1e3) * 0.90;
+
+    std::cout << newTargetMbb << std::endl;
+    std::cout << newTargetXr  << std::endl;
+
+    if (g_centralizedAgent)
+    {
+        g_centralizedAgent->ResetLearning(resetEpsilon, newTargetMbb, newTargetXr);
+
+        std::cout << "\n[EVENT] T=" << Simulator::Now().GetSeconds()
+                  << "s | MBB rate changed to " << newDataRateMbbMbps
+                  << " Mbps | XR rate changed to " << newDataRateXrMbps
+                  << " Mbps | MAB Reset (Eps=" << resetEpsilon << ")\n" << std::endl;
+    }
+
+    // Publish updated targets to Redis so that the O-RAN xApp can read them
+    std::string redisCmd = "redis-cli -h 127.0.0.1 -p 6379 HSET config:mab"
+                           " target_mbb " + std::to_string(newTargetMbb) +
+                           " target_xr "  + std::to_string(newTargetXr)  +
+                           " > /dev/null 2>&1";
+
+    int ret = system(redisCmd.c_str());
+    if (ret != 0) {
+        std::cout << "[WARNING] Failed to update Redis. Is the port-forward running?" << std::endl;
+    } else {
+        std::cout << "[O-RAN] Targets updated in Redis for xApp: MBB="
+                  << newTargetMbb << ", XR=" << newTargetXr << std::endl;
+    }
+}
