 namespace ns3 {
 
+/**
+ * @brief Helper for building E2 indication messages at the LTE master node.
+ *
+ * LteIndicationMessageHelper extends IndicationMessageHelper to provide
+ * LTE-specific methods that populate CU-UP and CU-CP performance measurement
+ * (PM) containers reported over the O-RAN E2 interface.  These measurements
+ * support MR-DC bearer split-ratio optimisation by an xApp running on the
+ * Near-RT RIC.
+ */
 class LteIndicationMessageHelper : public IndicationMessageHelper
 {
 public:
+  /**
+   * @brief Constructs an LteIndicationMessageHelper.
+   *
+   * @param type             The E2SM indication message type
+   *                         (e.g., REPORT or INSERT).
+   * @param isOffline        If @c true, the helper operates in offline mode
+   *                         and does not encode ASN.1 structures for live
+   *                         transmission.
+   * @param reducedPmValues  If @c true, only a reduced set of PM counters is
+   *                         populated, reducing message size.
+   */
   LteIndicationMessageHelper (IndicationMessageType type, bool isOffline, bool reducedPmValues);
 
+  /**
+   * @brief Destructor.
+   */
   ~LteIndicationMessageHelper ();
 
+  /**
+   * @brief Populates the CU-UP container with aggregate PDCP byte counters.
+   *
+   * Records the uplink and downlink PDCP data volumes for the reporting
+   * interval, along with the PLMN identity of this CU-UP instance.
+   * Per-UE entries are added separately via AddCuUpUePmItem().
+   *
+   * @param plmId        The Public Land Mobile Network (PLMN) identifier
+   *                     string associated with this CU-UP instance.
+   * @param pdcpBytesUl  Aggregate PDCP bytes received from UEs (uplink)
+   *                     during the reporting interval.
+   * @param pdcpBytesDl  Aggregate PDCP bytes delivered to UEs (downlink)
+   *                     during the reporting interval.
+   */
   void FillCuUpValues (std::string plmId, long pdcpBytesUl, long pdcpBytesDl);
 
-  void AddCuUpUePmItem  (std::string ueImsiComplete, long txBytes, long txDlPackets,
-                           double pdcpThroughput, double pdcpLatency);
-
+  /**
+   * @brief Adds a per-UE PDCP throughput entry to the CU-UP PM container.
+   *
+   * Records the PDCP-to-RLC throughput and the QoS Class Identifier (QCI)
+   * for a specific UE bearer, to be included in the E2 indication message.
+   *
+   * @param ueImsiComplete      The UE's IMSI as a complete string identifier.
+   * @param pdcp2RlcThroughput  PDCP-to-RLC aggregate throughput for the UE
+   *                            (in kbps).
+   * @param qci                 QoS Class Identifier of the bearer.
+   */
+  void AddCuUpUePmItem (std::string ueImsiComplete, double pdcp2RlcThroughput, double qci);
+
+  /**
+   * @brief Adds a cell-level average PDCP latency entry to the CU-UP PM container.
+   *
+   * Records the mean PDCP-layer packet delay observed across all active UEs
+   * in the cell during the current reporting interval.
+   *
+   * @param cellAverageLatency  Mean PDCP packet latency for the cell (in ms).
+   */
   void AddCuUpCellPmItem (double cellAverageLatency);
 
+  /**
+   * @brief Populates the CU-CP container with RRC-layer aggregate statistics.
+   *
+   * Records the number of RRC-connected UEs at the CU-CP, to be included in
+   * the E2 indication message.
+   *
+   * @param numActiveUes  Number of UEs currently in RRC_CONNECTED state.
+   */
   void FillCuCpValues (uint16_t numActiveUes);
 
-  void AddCuCpUePmItem (std::string ueImsiComplete, long numDrb, long drbRelAct);
+  /**
+   * @brief Adds a per-UE RRC measurement entry to the CU-CP PM container.
+   *
+   * Records the number of active DRBs and the L3-filtered serving-cell
+   * RSRP/RSRQ measurement for a specific UE.
+   *
+   * @param ueImsiComplete           The UE's IMSI as a complete string
+   *                                 identifier.
+   * @param numDrb                   Number of Data Radio Bearers currently
