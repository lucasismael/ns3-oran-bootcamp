+                                     MakeDoubleAccessor (&MmWaveRadioEnvironmentMapHelper::SetMinX,
+                                                         &MmWaveRadioEnvironmentMapHelper::GetMinX),
+                                     MakeDoubleChecker<double> ())
+                      .AddAttribute ("YMin",
+                                     "The min y coordinate of the map.",
+                                     DoubleValue (0.0),
+                                     MakeDoubleAccessor (&MmWaveRadioEnvironmentMapHelper::SetMinY,
+                                                         &MmWaveRadioEnvironmentMapHelper::GetMinY),
+                                     MakeDoubleChecker<double> ())
+                      .AddAttribute ("XMax",
+                                     "The max x coordinate of the map.",
+                                     DoubleValue (0.0),
+                                     MakeDoubleAccessor (&MmWaveRadioEnvironmentMapHelper::SetMaxX,
+                                                         &MmWaveRadioEnvironmentMapHelper::GetMaxX),
+                                     MakeDoubleChecker<double> ())
+                      .AddAttribute ("YMax",
+                                     "The max y coordinate of the map.",
+                                     DoubleValue (0.0),
+                                     MakeDoubleAccessor (&MmWaveRadioEnvironmentMapHelper::SetMaxY,
+                                                         &MmWaveRadioEnvironmentMapHelper::GetMaxY),
+                                     MakeDoubleChecker<double> ())
+                      .AddAttribute ("XRes",
+                                     "The resolution (number of points) of the"
+                                     "map along the x axis.",
+                                     UintegerValue (100),
+                                     MakeUintegerAccessor (&MmWaveRadioEnvironmentMapHelper::SetResX,
+                                                           &MmWaveRadioEnvironmentMapHelper::GetResX),
+                                     MakeUintegerChecker<uint32_t> (2,std::numeric_limits<uint16_t>::max ()))
+                      .AddAttribute ("YRes",
+                                     "The resolution (number of points) of the"
+                                     "map along the y axis.",
+                                     UintegerValue (100),
+                                     MakeUintegerAccessor (&MmWaveRadioEnvironmentMapHelper::SetResY,
