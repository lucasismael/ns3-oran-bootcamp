+            iterador_com_barra = tqdm(pool.imap_unordered(run_simulation, comandos_pendentes), total=len(comandos_pendentes), desc=f"Progresso (Tent. {tentativa})")
+            for res in iterador_com_barra:
+                resultados.append(res)
+            
+        comandos_falhos = []
+        
+        for sucesso, msg, cmd in resultados:
+            if sucesso:
+                relatorio_final.append(msg)
+            else:
+                tqdm.write(msg) # Imprime o erro acima da barra de progresso, sem quebrá-la
+                comandos_falhos.append(cmd)
+                
+        comandos_pendentes = comandos_falhos
+        tentativa += 1
+        
+    print("\n--- Relatório de Execução Final ---")
+    for res in relatorio_final:
