+void
+MmWaveDownlinkRadioEnvironmentMapHelper::CreateRem (const NetDeviceContainer &rtdNetDev,
+                                        const Ptr<NetDevice> &rrdDevice, uint8_t bwpId)
+{
+  NS_LOG_FUNCTION (this);
+
+  // save user defined beams, it is like a snapshot, because later during
+  // simulation they might change, and for the BEAM_SHAPE type of map
+  // is necessary to have a specific snapshot of beams for each device
+
+  // since we have delayed install maybe beamforming vector has changed in the RTD device
+  // we want to save beamforming vector toward UE in the case that we will
+  // need it for BEAM_SHAPE calculation
+
+  // Get the layer phy and a copy of the antenna arrays for each RTD
+  for (NetDeviceContainer::Iterator netDevIt = rtdNetDev.Begin ();
+      netDevIt != rtdNetDev.End ();
+      ++netDevIt)
+    {
+      Ptr<MmWaveEnbNetDevice> gnbRtdNetDevice = DynamicCast<MmWaveEnbNetDevice> (*netDevIt);
+      
+      //Ptr<MmWaveEnbNetDevice> gnbRtdNetDevice=(*netDevIt)->GetObject<MmWaveEnbNetDevice> ();
+      //Ptr<McUeNetDevice> ueRtdNetDevice=(*netDevIt)->GetObject<McUeNetDevice> ();
+      if (gnbRtdNetDevice)
+      {
+        std::cout << "gnb is RTD (transmitter)" << std::endl;
+        m_rtdDeviceToPhy.insert (std::make_pair (*netDevIt, (*netDevIt)->GetObject<MmWaveEnbNetDevice> ()->GetPhy (bwpId)));
+        m_deviceToAntenna.insert (std::make_pair (*netDevIt, Copy (gnbRtdNetDevice->GetAntenna (bwpId))));
+      }
+      else
+      {
+        NS_FATAL_ERROR ("no RTD device!");
+      }
+    }
+  
+
+  // Get the layer phy and a copy of the antenna arrays for the RRD. Check if the REM is used for Dl or Ul.
+  //Ptr<MmWaveEnbNetDevice> gnbRrdNetDevice = DynamicCast<MmWaveEnbNetDevice> (rrdDevice);
+  //Ptr<McUeNetDevice> ueRrdNetDevice = DynamicCast<McUeNetDevice> (rrdDevice);
+  Ptr<McUeNetDevice> ueRrdNetDevice=(rrdDevice)->GetObject<McUeNetDevice> ();
+
+  if (ueRrdNetDevice)
+  {
+    std::cout << "ue is RRD (receiver)" << std::endl;
+    m_rrdPhy = ueRrdNetDevice->GetMmWavePhy (bwpId);
+    m_deviceToAntenna.insert (std::make_pair (rrdDevice, Copy (ueRrdNetDevice->GetAntenna (bwpId))));
+    m_isDl=true; 
+  }
+  else
+  {
+    NS_FATAL_ERROR ("no RRD device!");
+  }
+  m_test = 10;
+
+  Simulator::Schedule (m_installationDelay, &MmWaveDownlinkRadioEnvironmentMapHelper::DelayedInstall, this, 
+                        rtdNetDev, rrdDevice, m_rtdDeviceToPhy, m_deviceToAntenna);
+}
