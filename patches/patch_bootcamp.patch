+                                                      MmWaveRadioEnvironmentMapHelper::UE_COVERAGE, "UeCoverageArea"))
+                      .AddAttribute ("InstallationDelay",
+                                     "How many time it is needed in the simulation to configure phy parameters at UE, "
+                                     "depends on RRC message timing.",
+                                     TimeValue (MilliSeconds (250)),
+                                     MakeTimeAccessor (&MmWaveRadioEnvironmentMapHelper::SetInstallationDelay),
+                                     MakeTimeChecker())
+    ;
+  return tid;
