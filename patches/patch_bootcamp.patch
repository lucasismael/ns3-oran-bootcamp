+        Idle = 1,
+        Sleep = 0,
+        OFF = 0
+    };
+
+    void SetCellState(enumModeEnergyBs value);
 
+    uint32_t GetmacPduInitialCellSpecificAttr();
+    std::string GetImsiString(uint64_t imsi);
