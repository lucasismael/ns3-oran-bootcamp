+double RunSimulationWithTimeCounter()
+{
+	// Measuring and printing start time
+	time_t beginTimer = time(&beginTimer);
+	struct tm *timeInfo;			   // Time structure
+	timeInfo = localtime(&beginTimer); // Binding timeInfo to local start time
+	std::cout << "Simulation start time: " << asctime(timeInfo) << std::endl;
+
+	// Running the simulation
+	Simulator::Run();
+	Simulator::Destroy();
+
+	// Measuring and printing end time
+	time_t finishTimer = time(&finishTimer);
+	timeInfo = localtime(&finishTimer); // Binding timeInfo to local end time
+	std::cout << "Simulation end time: " << asctime(timeInfo) << std::endl;
+
+	// Measuring and printing simulation duration
+	double elapsedTime = difftime(finishTimer, beginTimer); // Calculating simulation duration in seconds
+	if (elapsedTime >= 7200)
+	{
+		std::cout << "Simulation duration: " << elapsedTime / 3600 << " hours" << std::endl;
+	}
+	else if (elapsedTime >= 120)
+	{
+		std::cout << "Simulation duration: " << elapsedTime / 60 << " minutes" << std::endl;
+	}
+	else
+	{
+		std::cout << "Simulation duration: " << elapsedTime << " seconds" << std::endl;
+	}
+	return elapsedTime;
+}
