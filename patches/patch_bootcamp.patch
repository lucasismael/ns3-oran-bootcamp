+/**
+ * @brief Evaluates the reward signal and applies one MAB decision step.
+ *
+ * This function is invoked periodically (every @p interval seconds) and
+ * implements the closed-loop control cycle for the centralized MAB agent:
+ *   1. Collect per-UE throughput measurements from UeThroughputStorage.
+ *   2. Compute a scalar composite reward signal R(t).
+ *   3. Update the Q-value of the last selected arm via UpdateLastAction().
+ *   4. Select the next split ratio action via SelectAction().
+ *   5. Apply the selected split ratio to all mixed-service UEs via McEnbPdcp.
+ *
+ * **Traffic class and DRB mapping:**
+ *   - DRB_EMBB (DRB ID = 1): carries eMBB traffic, activated with QCI 2
+ *     (EpsBearer::GBR_CONV_VIDEO, 3GPP TS 23.203).
+ *     The corresponding per-UE throughput is referred to as @c tputMbb.
+ *   - DRB_XR   (DRB ID = 2): carries XR (Extended Reality) traffic,
+ *     activated with QCI 80 (EpsBearer::NGBR_LOW_LAT_EMBB_AR, 3GPP TS 23.501).
+ *     The corresponding per-UE throughput is referred to as @c tputXr.
+ *
+ * **Reward function R(t):**
+ * @f[
+ *   R(t) = \underbrace{W_{\mathrm{MBB}} \cdot S_{\mathrm{MBB}}(t)
+ *                    + W_{\mathrm{XR}}  \cdot S_{\mathrm{XR}}(t)}_{\text{satisfaction term}}
+ *        + W_{\mathrm{tput}} \cdot \bigl(
+ *              W_{\mathrm{MBB}} \cdot \hat{V}_{\mathrm{MBB}}(t)
+ *            + W_{\mathrm{XR}}  \cdot \hat{V}_{\mathrm{XR}}(t)
+ *          \bigr)
+ * @f]
+ * where:
+ *   - @f$S_k(t) = |\{i : \bar{v}_{k,i}(t) \ge T_k^*\}| / N@f$ is the fraction
+ *     of UEs satisfying the QoS target @f$T_k^*@f$ for service class @f$k@f$.
+ *   - @f$\hat{V}_k(t) = \bar{v}_k(t) / (T_k^* / 0.9)@f$ normalizes the mean
+ *     per-UE throughput to the maximum offered load.
+ *   - @f$W_{\mathrm{tput}} = 0.05@f$ keeps the throughput term as a secondary
+ *     tie-breaking signal; QoS satisfaction is always the dominant objective.
+ *
+ * **Split ratio action encoding (arm index → LTE fraction):**
+ *   | Arm | splitRatio | Traffic routing          |
+ *   |-----|-----------|--------------------------|
+ *   |  0  |   0.00    | All traffic via mmWave   |
+ *   |  1  |   0.25    | 25 % LTE / 75 % mmWave   |
+ *   |  2  |   0.50    | Balanced                 |
+ *   |  3  |   0.75    | 75 % LTE / 25 % mmWave   |
+ *   |  4  |   1.00    | All traffic via LTE      |
+ *
+ * The split ratio is applied only to DRB_EMBB (QCI 2); DRB_XR (QCI 80) is
+ * always forwarded entirely via mmWave (splitRatio = 0.0) to exploit the
+ * low-latency characteristics of the mmWave link for XR traffic.
+ *
+ * @param uesNetDevs  Container of mixed-service UE net devices.
+ * @param interval    Scheduling interval between consecutive MAB decisions.
+ * @param mbbPriority Weight @f$W_{\mathrm{MBB}} \in [0,1]@f$ for eMBB in the
+ *                    weighted satisfaction term (XR weight = 1 − mbbPriority).
+ */
+void UpdateMabPolicy(NetDeviceContainer uesNetDevs, Time interval, double mbbPriority)
+{
+    if (!g_centralizedAgent) return;
+
+    double targetMbb = g_centralizedAgent->GetTargetMbb();
+    double targetXr  = g_centralizedAgent->GetTargetXr();
+
+    double totalThroughputSum   = 0.0;
+    double throughputSumMbb     = 0.0;
+    double throughputSumXr      = 0.0;
+    double satisfactionCountMbb = 0.0;
+    double satisfactionCountXr  = 0.0;
+
+    // DRB IDs match the bearer activation order in main():
+    //   DRB 1 → eMBB traffic (QCI 2, EpsBearer::GBR_CONV_VIDEO)
+    //   DRB 2 → XR  traffic (QCI 80, EpsBearer::NGBR_LOW_LAT_EMBB_AR)
+    const int DRB_EMBB = 1;
+    const int DRB_XR   = 2;
+
+    for (uint32_t i = 0; i < uesNetDevs.GetN(); i++)
+    {
+        Ptr<McUeNetDevice> mcDev = DynamicCast<McUeNetDevice>(uesNetDevs.Get(i));
+        uint64_t imsi = mcDev->GetImsi();
+
+        // tputMbb: aggregate (LTE + NR) throughput [kbps] for DRB 1 (QCI 2 – eMBB)
+        double tputMbb = UeThroughputStorage::GetAggregatedThroughput(imsi, DRB_EMBB);
+        // tputXr:  aggregate (LTE + NR) throughput [kbps] for DRB 2 (QCI 80 – XR)
+        double tputXr  = UeThroughputStorage::GetAggregatedThroughput(imsi, DRB_XR);
+
+        totalThroughputSum += (tputMbb + tputXr);
+        throughputSumMbb   += tputMbb;
+        throughputSumXr    += tputXr;
+
+        // QoS satisfaction: 1 if the UE's throughput meets the target, 0 otherwise
+        if (tputMbb >= targetMbb) satisfactionCountMbb += 1.0;
+        if (tputXr  >= targetXr)  satisfactionCountXr  += 1.0;
+    }
+
+    // --- Reward computation ---
+    // Satisfaction fractions S_k(t) ∈ [0, 1]
+    float S_mbb = satisfactionCountMbb / uesNetDevs.GetN();
+    float S_xr  = satisfactionCountXr  / uesNetDevs.GetN();
+
+    // Mean per-UE throughputs V_k(t) [kbps]
+    float V_mbb = throughputSumMbb / uesNetDevs.GetN();
+    float V_xr  = throughputSumXr  / uesNetDevs.GetN();
+
+    // Service weights: mbbPriority ∈ [0,1]; XR weight is complementary
+    double W_mbb = mbbPriority;
+    double W_xr  = 1.0 - W_mbb;
+
+    // Primary term: weighted QoS satisfaction (dominant objective)
+    float weighted_satisfaction = (W_mbb * S_mbb) + (W_xr * S_xr);
+
+    // Maximum offered load per service (target set at 90 % of offered load)
+    double maxThp_mbb = targetMbb / 0.9;
+    double maxThp_xr  = targetXr  / 0.9;
+
+    // Normalized throughput ∈ [0, 1]
+    float normalized_V_mbb = V_mbb / maxThp_mbb;
+    float normalized_V_xr  = V_xr  / maxThp_xr;
+
+    // Secondary term: normalized weighted throughput (tie-breaking signal)
+    float W_tput           = 0.05f;
+    float weighted_throughput = W_tput * ((W_mbb * normalized_V_mbb) + (W_xr * normalized_V_xr));
+
+    // Composite reward: R(t) = weighted_satisfaction + weighted_throughput
+    double reward = weighted_satisfaction + weighted_throughput;
+
+    // --- MAB update and action selection ---
+    g_centralizedAgent->UpdateLastAction(reward);
+    uint32_t globalAction = g_centralizedAgent->SelectAction();
+
+    // Map the selected arm index to the LTE split ratio
+    // (fraction of PDCP PDUs forwarded to the LTE RLC layer)
+    float splitRatio = 0.0f;
+    switch(globalAction) {
+        case 0: splitRatio = 0.00f; break; // All traffic via mmWave SN
+        case 1: splitRatio = 0.25f; break;
+        case 2: splitRatio = 0.50f; break; // Balanced split
+        case 3: splitRatio = 0.75f; break;
+        case 4: splitRatio = 1.00f; break; // All traffic via LTE MN
+    }
+
+    std::vector<double> currentQValues = g_centralizedAgent->GetQValues();
+
+    // Log to CSV for post-processing
+    if (g_mabStatsFile.is_open())
+    {
+        g_mabStatsFile << Simulator::Now().GetSeconds() << ","  // Time
+                       << reward       << ","                   // Reward
+                       << globalAction << ","                   // Action (arm index)
+                       << g_centralizedAgent->GetEpsilon() << "," // Epsilon
+                       << targetMbb   << ","                   // QoS target eMBB (QCI 2)
+                       << S_mbb       << ","                   // Satisfaction eMBB
+                       << targetXr    << ","                   // QoS target XR (QCI 80)
+                       << S_xr        << ","                   // Satisfaction XR
+                       << V_mbb       << ","                   // Mean throughput eMBB [kbps]
+                       << V_xr;                                // Mean throughput XR  [kbps]
+
+        // Q-values for all 5 arms (Q0 … Q4)
+        for (float q : currentQValues) {
+            g_mabStatsFile << "," << q;
+        }
+        g_mabStatsFile << std::endl;
+    }
+
+    NS_LOG_DEBUG("[MAB] T=" << Simulator::Now().GetSeconds()
+              << " | TargetMBB=" << targetMbb
+              << " | TargetXR="  << targetXr
+              << " | Eps="  << g_centralizedAgent->GetEpsilon()
+              << " | SatMbb=" << satisfactionCountMbb
+              << " | SatXr="  << satisfactionCountXr
+              << " | Rew=" << reward
+              << " | Act=" << globalAction);
+
+    std::cout << "[MAB] T=" << Simulator::Now().GetSeconds()
+              << " | TargetMBB=" << targetMbb
+              << " | TargetXR="  << targetXr
+              << " | Eps="  << g_centralizedAgent->GetEpsilon()
+              << " | SatMbb=" << satisfactionCountMbb
+              << " | SatXr="  << satisfactionCountXr
+              << " | Rew=" << reward
+              << " | Act=" << globalAction
+              << " | Q-Values: [";
+
+    for (size_t i = 0; i < currentQValues.size(); ++i) {
+        std::cout << currentQValues[i] << (i < currentQValues.size() - 1 ? ", " : "");
+    }
+    std::cout << "]" << std::endl;
+
+    // Apply the selected split ratio to DRB_EMBB (QCI 2) on all mixed-service UEs.
+    // DRB_XR (QCI 80) always uses splitRatio = 0.0 (fully offloaded to mmWave).
+    for (uint32_t i = 0; i < uesNetDevs.GetN(); i++)
+    {
+        Ptr<McUeNetDevice> mcDev = DynamicCast<McUeNetDevice>(uesNetDevs.Get(i));
+        uint16_t rnti = mcDev->GetLteRrc()->GetRnti();
+        if (rnti) {
+            ObjectMapValue mapValueLte;
+            mcDev->GetLteTargetEnb()->GetRrc()->GetUeManager(rnti)->GetAttribute("DataRadioBearerMap", mapValueLte);
+            for (auto iter = mapValueLte.Begin(); iter != mapValueLte.End(); ++iter) {
+                Ptr<LteDataRadioBearerInfo> drb = DynamicCast<LteDataRadioBearerInfo>(iter->second);
+                if (static_cast<int>(drb->m_drbIdentity) == DRB_EMBB) {
+                    // Apply the MAB-selected split ratio only to eMBB (QCI 2) bearers
+                    Ptr<McEnbPdcp> pdcp = DynamicCast<McEnbPdcp>(drb->m_pdcp);
+                    if (pdcp) pdcp->SetSplitRatio(splitRatio);
+                }
+            }
+        }
+    }
+
+    // Reschedule the next MAB decision step
+    Simulator::Schedule(interval, &UpdateMabPolicy, uesNetDevs, interval, mbbPriority);
+}
