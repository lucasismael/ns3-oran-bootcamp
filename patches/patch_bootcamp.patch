+    }
+    Ipv4InterfaceContainer ueIpIfaceBackground;
+    for (uint32_t i = 0; i < ueNodesBackground.GetN (); ++i) {
+        ueIpIfaceBackground.Add (ueIpIface.Get (ueNodesMixed.GetN () + i));
