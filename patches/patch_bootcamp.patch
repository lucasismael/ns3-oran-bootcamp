+    internet.Install (allUeNodes);
+    Ipv4InterfaceContainer ueIpIface = epcHelper->AssignUeIpv4Address (NetDeviceContainer (mcUeDevs));
+    
+    Ipv4InterfaceContainer ueIpIfaceMixed;
+    for (uint32_t i = 0; i < ueNodesMixed.GetN (); ++i) {
