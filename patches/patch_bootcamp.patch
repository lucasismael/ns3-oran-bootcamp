+void MmWaveMcRadioEnvironmentMapHelper::DelayedInstall (){
+	NS_LOG_FUNCTION (this);
+	
+	// Configure the variables m_rrd and m_rtd
+	ConfigureMmWaveRemDevices();
+	
+	// Get the propagation loss model and the spectrum propagation loss model from the rrd
+	Ptr<SpectrumChannel> spectrumChannel=m_rrd.spectrumPhy->GetSpectrumChannel ();
+	m_propagationLossModel=spectrumChannel->GetPropagationLossModel ();
+	//std::cout<<m_propagationLossModel->GetTypeId()<<std::endl;
+	m_spectrumLossModel=spectrumChannel->GetSpectrumPropagationLossModel ();
+	
+	// Get the noisePsd
+	m_noisePsd=MmWaveSpectrumValueHelper::CreateNoisePowerSpectralDensity (m_rrd.phyMacConfig,m_rrd.phy->GetNoiseFigure ());
+	
+
+	CalcCoverageAreaRem();
+	//CalcBeamShapeRem();
+	
+	PrintRemToFile();
+	
+	Simulator::Stop ();
+}
