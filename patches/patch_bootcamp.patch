+double
+MmWaveMcRadioEnvironmentMapHelper::DbmToW (double dBm) const
+{
+	return std::pow (10.0, 0.1 * (dBm - 30.0));
+}
+
+double
+MmWaveMcRadioEnvironmentMapHelper::WToDbm (double w) const
+{
+	return 10.0 * std::log10 (w) + 30.0;
+}
+
+double
+MmWaveMcRadioEnvironmentMapHelper::DbToRatio (double dB) const
+{
+	return std::pow (10.0, 0.1 * dB);
+}
+
+double
+MmWaveMcRadioEnvironmentMapHelper::RatioToDb (double ratio) const
+{
+	return 10.0 * std::log10 (ratio);
+}
