+ApplicationContainer createOnOffApplication(Ptr<Node> remoteHost, NetDeviceContainer uesNetDevs, Ipv4InterfaceContainer internetIpv4Interfaces, Ipv4InterfaceContainer uesIpv4Interfaces, bool dl = true,
+											bool ul = false, double dataRateInMbps = 1, uint16_t packetSize = 1024, uint16_t startDlPort = 10000, uint16_t startUlPort = 20000, double startTime=0.0, double endTime=120.0,uint8_t remoteHostIndexInContainer = 1)
+{
+
+    // Creating the container to save the OnOffApplications
+    ApplicationContainer allOnOffs;
+
+	// If both downlink and uplink are disabled, return empty container
+	if (not(dl or ul))
+	{
+		return allOnOffs;
+	}
+
+	// Setting up the ports to be used for the applications
+	uint16_t dlPort = startDlPort;
+	uint16_t ulPort = startUlPort;
+
+	// Configuring application parameters to appropriate formats
+	UintegerValue packetSizeUV = UintegerValue(packetSize);
+	DataRate dataRateInMbpsDR = DataRate(std::to_string(dataRateInMbps) + "Mib/s");
+
+	std::string socketFactory = "ns3::UdpSocketFactory";
+
+	// Iterating over the vector of UEs
+	for (uint8_t u = 0; u < uesNetDevs.GetN(); ++u)
+	{
+		// Selecting a UE node
+		Ptr<Node> ue = uesNetDevs.Get(u)->GetNode();
+
+		// Creating application containers
+		ApplicationContainer applications1;
+		ApplicationContainer applications2;
+
+		if (dl)
+		{
+			//-----------------------------------------Configuring DL----------------------------------------//
+			/* Instantiate the helper that configures the application.
+			 * Parameters:
+			 * * std::string protocol -> socket factory used to create sockets for the applications.
+			 * * Address address      -> destination remote address to receive traffic.
+			 */
+			OnOffHelper dlHelper(socketFactory, InetSocketAddress(uesIpv4Interfaces.GetAddress(u), dlPort));
+
+			// Configuring application attributes
+			dlHelper.SetAttribute("MaxBytes", UintegerValue(0)); // Infinite data limit (continuous transmission)
+			dlHelper.SetConstantRate(dataRateInMbpsDR, packetSize);
+
+			// Installing OnOff application on the remote host and adding to container
+			applications1.Add(dlHelper.Install(remoteHost));
+
+			// Creating PacketSinkHelper to consume generated traffic on the UE
+			PacketSinkHelper dlPacketSinkHelper(socketFactory, InetSocketAddress(Ipv4Address::GetAny(), dlPort));
+
+			// Installing PacketSink on the UE and adding to container
+			applications2.Add(dlPacketSinkHelper.Install(ue));
+		}
+		if (ul)
+		{
+			//-----------------------------------------Configuring UL----------------------------------------//
+			/* Instantiate the helper that configures the application.
+			 * Parameters:
+			 * * std::string protocol -> socket factory used to create sockets for the applications.
+			 * * Address address      -> destination remote address to receive traffic.
+			 */
+			OnOffHelper ulHelper(socketFactory, InetSocketAddress(internetIpv4Interfaces.GetAddress(remoteHostIndexInContainer), ulPort));
+
+			// Configuring application attributes
+			ulHelper.SetAttribute("MaxBytes", UintegerValue(0)); // Infinite data limit (continuous transmission)
+			ulHelper.SetConstantRate(dataRateInMbpsDR, packetSize);
+
+			// Installing OnOff application on the UE and adding to container
+			applications1.Add(ulHelper.Install(ue));
+
+			// Creating PacketSinkHelper on the remote host
+			PacketSinkHelper ulPacketSinkHelper(socketFactory, InetSocketAddress(Ipv4Address::GetAny(), ulPort));
+
+			// Installing PacketSink on the remote host and adding to container
+			applications2.Add(ulPacketSinkHelper.Install(remoteHost));
+
+		}
+
+		//-----------------------------------------Application Timing------------------------------------//
+		std::cout << "StartTime: " << startTime <<" | EndTime: "<< endTime <<std::endl;
+		applications1.Start(Seconds(startTime));
+		applications1.Stop(Seconds(endTime));
+		applications2.Start(Seconds(startTime));
+		applications2.Stop(Seconds(endTime));
+
+		// Incrementing UL and DL ports for the next UE
+		++dlPort;
+		++ulPort;
+
+        // Saving the on/off applications in the container
+        allOnOffs.Add(applications1);
+	}
+
+    return allOnOffs;
+}
