+{
+	Ptr<Building> building = CreateObject<Building>();	  // Create building object
+	building->SetBoundaries(Box(x1, x2, y1, y2, 0.0, h)); // Set building boundaries
+	building->SetNRoomsX(1);
+	building->SetNRoomsY(1);
+	building->SetNFloors(1);
+	building->SetBuildingType(Building::Commercial);		  // Building type
+	building->SetExtWallsType(Building::ConcreteWithWindows); // External walls type
+	return building;
+}
+
+Ptr<Building> CreateBuilding(Box buildingBox)
+{
+	Ptr<Building> building = CreateObject<Building>(); // Create building object
+	building->SetBoundaries(buildingBox);			   // Set building boundaries
+	building->SetNRoomsX(1);
+	building->SetNRoomsY(1);
+	building->SetNFloors(1);
+	building->SetBuildingType(Building::Commercial);		  // Building type
+	building->SetExtWallsType(Building::ConcreteWithWindows); // External walls type
+	return building;
+}
