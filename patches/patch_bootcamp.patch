+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+
+#ifndef MAB_AGENT_H
+#define MAB_AGENT_H
+
+/**
+ * @file mab-agent.h
+ * @brief Multi-Armed Bandit (MAB) agent for MR-DC traffic split ratio control.
+ *
+ * This module implements an epsilon-greedy Multi-Armed Bandit (MAB) agent
+ * that autonomously selects the optimal downlink traffic split ratio between
+ * the LTE anchor (MN) and the mmWave Secondary Node (SN) in an EN-DC
+ * (E-UTRA-NR Dual Connectivity) MR-DC architecture.
+ *
+ * The agent maintains a Q-value table over a discrete action set and is
+ * updated via a composite reward signal that balances QoS satisfaction for
+ * two heterogeneous traffic classes:
+ *   - **eMBB** (Enhanced Mobile Broadband): carried on DRB 1,
+ *     mapped to QCI 2 (GBR_CONV_VIDEO, 3GPP TS 23.203).
+ *   - **XR**   (Extended Reality): carried on DRB 2,
+ *     mapped to QCI 80 (NGBR_LOW_LAT_EMBB_AR, 3GPP TS 23.501).
+ *
+ * @see UpdateMabPolicy() in scratch/scenario-master.cc for the reward computation.
+ */
+
+#include "ns3/object.h"
+#include "ns3/random-variable-stream.h"
+#include <vector>
+
+namespace ns3 {
+
+/**
+ * @brief Epsilon-greedy Multi-Armed Bandit agent for MR-DC split ratio control.
+ *
+ * MabAgent implements an online reinforcement learning agent based on the
+ * epsilon-greedy bandit algorithm with incremental Q-value updates and
+ * optional exponential epsilon decay.  It is designed for use in
+ * Multi-Radio Dual Connectivity (MR-DC / EN-DC) scenarios where the
+ * controller must dynamically allocate downlink traffic between an LTE
+ * Master Node (MN) and an mmWave Secondary Node (SN) via the McEnbPdcp
+ * probabilistic packet-splitting mechanism.
+ *
+ * **Arm-to-split-ratio mapping:**
+ *   - Arm 0: splitRatio = 0.00  (all traffic via mmWave SN)
+ *   - Arm 1: splitRatio = 0.25
+ *   - Arm 2: splitRatio = 0.50  (balanced)
+ *   - Arm 3: splitRatio = 0.75
+ *   - Arm 4: splitRatio = 1.00  (all traffic via LTE MN)
+ *
+ * Q-values are initialized to a large optimistic value (InitialQValue) to
+ * encourage systematic exploration before exploitation begins.
+ *
+ * **Configurable ns-3 Attributes:**
+ *   - `Epsilon`       – Initial exploration probability ε ∈ [0, 1].
+ *   - `EpsilonMin`    – Floor for ε after exponential decay.
+ *   - `DecayFactor`   – Per-step multiplicative factor applied to ε.
+ *   - `LearningRate`  – Step-size α for Q-value updates (0 ⇒ sample mean).
+ *   - `InitialQValue` – Optimistic initial Q-value to drive early exploration.
+ */
+class MabAgent : public Object
+{
+public:
+    /**
+     * @brief Returns the ns-3 TypeId for this class.
+     * @return TypeId associated with MabAgent.
+     */
+    static TypeId GetTypeId (void);
+
+    MabAgent ();
+    virtual ~MabAgent ();
+
+    // -------------------------------------------------------------------
+    // Configuration
+    // -------------------------------------------------------------------
+
+    /**
+     * @brief Sets the number of arms (discrete actions) in the bandit.
+     *
+     * Initializes the Q-value table and action-count vector to @p nArms
+     * entries.  All Q-values are set to the configured InitialQValue to
+     * promote optimistic exploration of all arms.
+     *
+     * @param nArms Number of arms.  In the MR-DC split ratio context this
+     *              is 5, corresponding to LTE fractions
+     *              {0.0, 0.25, 0.50, 0.75, 1.0}.
+     */
+    void SetNumberOfArms (uint32_t nArms);
+
+    /**
+     * @brief Assigns the random stream used for epsilon-greedy exploration.
+     * @param streamId Stream index from the ns-3 RNG manager; tied to
+     *                 RngSeed for cross-run reproducibility.
+     */
+    void SetStream (int64_t streamId);
+
+    /**
+     * @brief Sets the per-service throughput targets for the reward function.
+     *
+     * Targets define the QoS satisfaction thresholds evaluated in
+     * UpdateMabPolicy() (scenario-master.cc):
+     *   - @p targetMbb: aggregate throughput target for eMBB traffic
+     *     (DRB 1, QCI 2 – GBR_CONV_VIDEO), in kbps.
+     *   - @p targetXr:  aggregate throughput target for XR traffic
+     *     (DRB 2, QCI 80 – NGBR_LOW_LAT_EMBB_AR), in kbps.
+     *
+     * @param targetMbb  Target throughput [kbps] for eMBB (QCI 2).
+     * @param targetXr   Target throughput [kbps] for XR  (QCI 80).
+     */
+    void SetTargets (double targetMbb, double targetXr);
+
+    /**
+     * @brief Resets the agent's learning state to adapt to a new traffic regime.
+     *
+     * Invoked when the offered load changes (e.g., in the "Step" or
+     * "Robustness" scenarios).  Resets all Q-values to the optimistic initial
+     * value, zeroes action counts, restores exploration to @p resetEpsilon,
+     * and updates both QoS targets to reflect the new offered load.
+     *
+     * @param resetEpsilon  Exploration rate ε to restore after the reset.
+     * @param newTargetMbb  Updated eMBB throughput target [kbps] (QCI 2).
+     * @param newTargetXr   Updated XR  throughput target  [kbps] (QCI 80).
+     */
+    void ResetLearning (double resetEpsilon, double newTargetMbb, double newTargetXr);
+
+    // -------------------------------------------------------------------
+    // Decision cycle
+    // -------------------------------------------------------------------
+
+    /**
+     * @brief Selects the next split ratio action using the epsilon-greedy policy.
+     *
+     * With probability ε (after applying exponential decay), a uniformly
+     * random arm is selected (exploration).  With probability 1 − ε, the arm
+     * with the highest current Q-value is selected (exploitation).
+     *
+     * The selected arm index is stored internally so that UpdateLastAction()
+     * can update the correct Q-value without requiring the caller to pass
+     * the arm index again.
+     *
+     * @return Index of the selected arm in [0, nArms − 1].
+     */
+    uint32_t SelectAction (void);
+
+    /**
+     * @brief Updates the Q-value of the last selected arm with the observed reward.
+     *
+     * Applies the incremental update rule:
+     * @f[
+     *   Q(a) \leftarrow Q(a) + \alpha \cdot (\text{reward} - Q(a))
+     * @f]
+     * where @f$\alpha@f$ is the configured LearningRate, or @f$1/N(a)@f$
+     * (sample mean) when LearningRate = 0.
+     *
+     * @param reward  Scalar reward signal from UpdateMabPolicy().
+     *                Higher values indicate better joint QoS performance.
+     */
+    void UpdateLastAction (double reward);
+
+    // -------------------------------------------------------------------
+    // Inspection / debug accessors
+    // -------------------------------------------------------------------
+
+    /**
+     * @brief Returns a copy of the current Q-value table (one entry per arm).
+     * @return Vector of Q-values.
+     */
+    std::vector<double> GetQValues () const;
+
+    /**
+     * @brief Returns a copy of the per-arm selection counts.
+     * @return Vector of action counts.
+     */
+    std::vector<uint32_t> GetActionCounts () const;
+
+    /**
+     * @brief Returns the current eMBB throughput target in kbps (DRB 1, QCI 2).
+     * @return Target eMBB throughput [kbps].
+     */
+    double GetTargetMbb () const;
+
+    /**
+     * @brief Returns the current XR throughput target in kbps (DRB 2, QCI 80).
+     * @return Target XR throughput [kbps].
+     */
+    double GetTargetXr () const;
+
+    /**
+     * @brief Returns the current exploration rate ε.
+     * @return Current epsilon in [EpsilonMin, 1.0].
+     */
+    double GetEpsilon () const;
+
+private:
+    /**
+     * @brief Selects the arm with the highest Q-value (greedy exploitation).
+     * @return Index of the arm with maximum Q-value; lowest index on ties.
+     */
+    uint32_t FindGreedyAction (void) const;
+
+    uint32_t m_nArms;       ///< Total number of bandit arms.
+    uint32_t m_lastAction;  ///< Index of the most recently selected arm.
+
+    std::vector<double>   m_qValues;      ///< Q-value estimates, one per arm.
+    std::vector<uint32_t> m_actionCounts; ///< Selection counts, one per arm.
+
+    Ptr<UniformRandomVariable> m_rng; ///< RNG for epsilon-greedy exploration.
+
+    // Configurable ns-3 attributes
+    double m_epsilon;      ///< Current exploration probability ε.
+    double m_epsilonMin;   ///< Minimum ε floor after exponential decay.
+    double m_decayFactor;  ///< Per-step multiplicative decay applied to ε.
+    double m_learningRate; ///< Step-size α for Q-value updates (0 → sample mean).
+    double m_initialQ;     ///< Optimistic initial Q-value for all arms.
+
+    double m_targetMbb; ///< QoS throughput target [kbps] for eMBB (DRB 1, QCI 2).
+    double m_targetXr;  ///< QoS throughput target [kbps] for XR  (DRB 2, QCI 80).
+};
+
+} // namespace ns3
