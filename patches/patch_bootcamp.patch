+
+namespace ns3 {
+
+NS_LOG_COMPONENT_DEFINE ("UdpPoissonServer");
+
+NS_OBJECT_ENSURE_REGISTERED (UdpPoissonServer);
+
+
+TypeId
+UdpPoissonServer::GetTypeId (void)
+{
+  static TypeId tid = TypeId ("ns3::UdpPoissonServer")
+    .SetParent<Application> ()
+    .SetGroupName("Applications")
+    .AddConstructor<UdpPoissonServer> ()
+    .AddAttribute ("Port",
+                   "Port on which we listen for incoming packets.",
+                   UintegerValue (100),
+                   MakeUintegerAccessor (&UdpPoissonServer::m_port),
+                   MakeUintegerChecker<uint16_t> ())
+    .AddAttribute ("PacketWindowSize",
+                   "The size of the window used to compute the packet loss. This value should be a multiple of 8.",
+                   UintegerValue (32),
+                   MakeUintegerAccessor (&UdpPoissonServer::GetPacketWindowSize,
+                                         &UdpPoissonServer::SetPacketWindowSize),
+                   MakeUintegerChecker<uint16_t> (8,256))
+    .AddTraceSource ("Rx", "A packet has been received",
+                     MakeTraceSourceAccessor (&UdpPoissonServer::m_rxTrace),
+                     "ns3::Packet::TracedCallback")
+    .AddTraceSource ("RxWithAddresses", "A packet has been received",
+                     MakeTraceSourceAccessor (&UdpPoissonServer::m_rxTraceWithAddresses),
+                     "ns3::Packet::TwoAddressTracedCallback")
+  ;
+  return tid;
+}
+
+UdpPoissonServer::UdpPoissonServer ()
+  : m_lossCounter (0)
+{
+  NS_LOG_FUNCTION (this);
+  m_received=0;
+}
+
+UdpPoissonServer::~UdpPoissonServer ()
+{
+  NS_LOG_FUNCTION (this);
+}
+
+uint16_t
+UdpPoissonServer::GetPacketWindowSize () const
+{
+  NS_LOG_FUNCTION (this);
+  return m_lossCounter.GetBitMapSize ();
+}
+
+void
+UdpPoissonServer::SetPacketWindowSize (uint16_t size)
+{
+  NS_LOG_FUNCTION (this << size);
+  m_lossCounter.SetBitMapSize (size);
+}
+
+uint32_t
+UdpPoissonServer::GetLost (void) const
+{
+  NS_LOG_FUNCTION (this);
+  return m_lossCounter.GetLost ();
+}
+
+uint64_t
+UdpPoissonServer::GetReceived (void) const
+{
+  NS_LOG_FUNCTION (this);
+  return m_received;
+}
+
+void
+UdpPoissonServer::DoDispose (void)
+{
+  NS_LOG_FUNCTION (this);
+  Application::DoDispose ();
+}
+
+void
+UdpPoissonServer::StartApplication (void)
+{
+  NS_LOG_FUNCTION (this);
+
+  if (m_socket == 0)
+    {
+      TypeId tid = TypeId::LookupByName ("ns3::UdpSocketFactory");
+      m_socket = Socket::CreateSocket (GetNode (), tid);
+      InetSocketAddress local = InetSocketAddress (Ipv4Address::GetAny (),
+                                                   m_port);
+      if (m_socket->Bind (local) == -1)
+        {
+          NS_FATAL_ERROR ("Failed to bind socket");
+        }
+    }
+
+  m_socket->SetRecvCallback (MakeCallback (&UdpPoissonServer::HandleRead, this));
+
+  if (m_socket6 == 0)
+    {
+      TypeId tid = TypeId::LookupByName ("ns3::UdpSocketFactory");
+      m_socket6 = Socket::CreateSocket (GetNode (), tid);
+      Inet6SocketAddress local = Inet6SocketAddress (Ipv6Address::GetAny (),
+                                                   m_port);
+      if (m_socket6->Bind (local) == -1)
+        {
+          NS_FATAL_ERROR ("Failed to bind socket");
+        }
+    }
+
+  m_socket6->SetRecvCallback (MakeCallback (&UdpPoissonServer::HandleRead, this));
+
+}
+
+void
+UdpPoissonServer::StopApplication ()
+{
+  NS_LOG_FUNCTION (this);
+
+  if (m_socket != 0)
+    {
+      m_socket->SetRecvCallback (MakeNullCallback<void, Ptr<Socket> > ());
+    }
+}
+
+void
+UdpPoissonServer::HandleRead (Ptr<Socket> socket)
+{
+  NS_LOG_FUNCTION (this << socket);
+  Ptr<Packet> packet;
+  Address from;
+  Address localAddress;
+  while ((packet = socket->RecvFrom (from)))
+    {
+      socket->GetSockName (localAddress);
+      m_rxTrace (packet);
+      m_rxTraceWithAddresses (packet, from, localAddress);
+      if (packet->GetSize () > 0)
+        {
+          uint32_t receivedSize = packet->GetSize ();
+          SeqTsHeader seqTs;
+          packet->RemoveHeader (seqTs);
+          uint32_t currentSequenceNumber = seqTs.GetSeq ();
+          if (InetSocketAddress::IsMatchingType (from))
+            {
+              NS_LOG_INFO ("TraceDelay: RX " << receivedSize <<
+                           " bytes from "<< InetSocketAddress::ConvertFrom (from).GetIpv4 () <<
+                           " Sequence Number: " << currentSequenceNumber <<
+                           " Uid: " << packet->GetUid () <<
+                           " TXtime: " << seqTs.GetTs () <<
+                           " RXtime: " << Simulator::Now () <<
+                           " Delay: " << Simulator::Now () - seqTs.GetTs ());
+            }
+          else if (Inet6SocketAddress::IsMatchingType (from))
+            {
+              NS_LOG_INFO ("TraceDelay: RX " << receivedSize <<
+                           " bytes from "<< Inet6SocketAddress::ConvertFrom (from).GetIpv6 () <<
+                           " Sequence Number: " << currentSequenceNumber <<
+                           " Uid: " << packet->GetUid () <<
+                           " TXtime: " << seqTs.GetTs () <<
+                           " RXtime: " << Simulator::Now () <<
+                           " Delay: " << Simulator::Now () - seqTs.GetTs ());
+            }
+
+          m_lossCounter.NotifyReceived (currentSequenceNumber);
+          m_received++;
+        }
+    }
+}
+
+} // Namespace ns3
