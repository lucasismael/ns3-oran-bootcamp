+void MmWaveRadioEnvironmentMapHelper::ConfigureRrd (const Ptr<NetDevice> &rrdDevice)
+{
+  NS_LOG_FUNCTION (this);
+  // RTD and RRD devices should have the same spectrum model to perform calculation,
+  // if some of the RTD devices is of the different model then its transmission will have to
+  // converted into spectrum model of this device
+
+  Ptr<MmWaveEnbNetDevice> gnbRrdNetDevice=(rrdDevice)->GetObject<MmWaveEnbNetDevice> ();
+  Ptr<McUeNetDevice> ueRrdNetDevice=(rrdDevice)->GetObject<McUeNetDevice> ();
+
+  if (gnbRrdNetDevice)
+  {
+    std::cout <<"gnb is RRD (receiver)" << std::endl;
+    m_rrdPhy = gnbRrdNetDevice->GetPhy (m_ccId);
+    m_rrd.antenna = Copy (gnbRrdNetDevice->GetAntenna (m_ccId));
+    m_isDl=false; 
+  }
+  else if (ueRrdNetDevice)
+  {
+    std::cout << "ue is RRD (receiver)" << std::endl;
+    m_rrdPhy = ueRrdNetDevice->GetMmWavePhy (m_ccId);
+    m_rrd.antenna = Copy (ueRrdNetDevice->GetAntenna (m_ccId));
+    m_isDl=true; 
+  }
+  else
+  {
+    NS_FATAL_ERROR ("no RRD device!");
+  }
+
+  // Set the MmWavePhyMacCommom of the rrd
+  m_rrd.configParam = m_rrdPhy->GetConfigurationParameters();
+  // Set the SpectrumModel of the rrd
+  m_rrd.spectrumModel=MmWaveSpectrumValueHelper::GetSpectrumModel(m_rrd.configParam);
+  // Set the position of the m_rrd 
+  m_rrd.mob->SetPosition (rrdDevice->GetNode ()->GetObject<MobilityModel> ()->GetPosition ());
+
+  // Print the position of the UEs
+  std::ostringstream oss;
+  oss << "mmwave-rem-" << m_simTag.c_str() << "-ues.txt";
+  PrintGnuplottableUeListToFile (oss.str ());
+
+  // Aggregate the MobilityBuildingInfo to the mobility model of the m_rrd
+  Ptr<MobilityBuildingInfo> buildingInfo = CreateObject<MobilityBuildingInfo> ();
+  m_rrd.mob->AggregateObject (buildingInfo);
+
+  // Set the antenna of the m_rrd
+  //m_rrd.antenna=m_deviceToAntenna.at(rrdDevice->GetNode()->GetId());
+  //m_rrd.antenna = m_deviceToAntenna.find (rrdDevice)->second;
+  //m_rrd.antenna = m_deviceToAntenna.find (rrdDevice->GetNode()->GetId())->second;
+  //m_rrd.antenna=rrdDevice->GetAntenna(m_ccId);
+
+  // Calculate the noise psd
+  m_noisePsd = MmWaveSpectrumValueHelper::CreateNoisePowerSpectralDensity (m_rrdPhy->GetNoiseFigure (), m_rrd.spectrumModel);
+
+  // Set the object factories that will copy the propagation model. We can call only once configuration of prop.models. 
+  //This function might be a source of error, verify later.
+  Ptr<MmWaveSpectrumPhy> rrdSpectrumPhy;
+  if(m_isDl){
+    Ptr<MmWaveUePhy> uePhy=DynamicCast<MmWaveUePhy>(m_rrdPhy);
+    rrdSpectrumPhy=uePhy->GetDlSpectrumPhy();
+  }else{
+    Ptr<MmWaveEnbPhy> enbPhy=DynamicCast<MmWaveEnbPhy>(m_rrdPhy);
+    rrdSpectrumPhy=enbPhy->GetUlSpectrumPhy();
+  }
+  ConfigurePropagationModelsFactories(rrdSpectrumPhy);
+
+  // Configure a new MmWaveBeamforlingModel factory with the same type id as the one in m_rrd.
+  // This ObjectFactory will be used to create all bfModels in this class.
+  TypeId bfModelTypeId;
+  Ptr<MmWaveDftBeamforming> dftBfModel=DynamicCast<MmWaveDftBeamforming> (rrdSpectrumPhy->GetBeamformingModel());
+  Ptr<MmWaveSvdBeamforming> svdBfModel=DynamicCast<MmWaveSvdBeamforming> (rrdSpectrumPhy->GetBeamformingModel());
+  if(dftBfModel){
+    bfModelTypeId=dftBfModel->GetTypeId();
+  }else if(svdBfModel){
+    bfModelTypeId=svdBfModel->GetTypeId();
+  }else{
+    NS_FATAL_ERROR("The rrd device uses an unknown beamforming model.");
+  }
+  m_mmwaveBeamformingModelFactory.SetTypeId (bfModelTypeId);
+
+  // Use the m_mmwaveBeamformingModelFactory to create a new MmWaveBeamformingModel for the m_rrd
+  m_rrd.bfModel = DynamicCast<MmWaveBeamformingModel> (m_mmwaveBeamformingModelFactory.Create());
+  m_rrd.bfModel->SetDevice(m_rrd.dev);
+  m_rrd.bfModel->SetAntenna(m_rrd.antenna);
+  
+}
+
+void MmWaveRadioEnvironmentMapHelper::ConfigureRtdList (const NetDeviceContainer& rtdDevs)
+{
+  NS_LOG_FUNCTION (this);
+
+  for (NetDeviceContainer::Iterator netDevIt = rtdDevs.Begin ();
+      netDevIt != rtdDevs.End ();
+      ++netDevIt)
+    {
+      Ptr<MmWaveEnbNetDevice> gnbRtdNetDevice = DynamicCast<MmWaveEnbNetDevice> (*netDevIt);
+      Ptr<McUeNetDevice> ueRtdNetDevice = DynamicCast<McUeNetDevice> (*netDevIt);
+      Ptr<MmWavePhy> rtdPhy;
+      Ptr<ThreeGppAntennaArrayModel> rtdAntenna;
+
+      if (gnbRtdNetDevice){
+        std::cout << "gnb is RTD (transmitter)" << std::endl;
+        if(!m_isDl){
+          NS_FATAL_ERROR ("RRD and RTD devices cannot be the same type.");
+        }
+        rtdPhy=gnbRtdNetDevice->GetPhy (m_ccId);
+        rtdAntenna=Copy(gnbRtdNetDevice->GetAntenna(m_ccId));
+      }else if(ueRtdNetDevice){
+        std::cout << "ue is RTD (transmitter)" << std::endl;
+        if(m_isDl){
+          NS_FATAL_ERROR ("RRD and RTD devices cannot be the same type.");
+        }
+        rtdPhy=ueRtdNetDevice->GetMmWavePhy(m_ccId);
+        rtdAntenna=Copy(ueRtdNetDevice->GetAntenna(m_ccId));
+      }else{
+        NS_FATAL_ERROR ("no RTD device!");
+      }
+
+
+
+
+      //uint32_t rtdId = (*netDevIt)->GetNode()->GetId();
+      // Find the phy layer, the configuration parameters and the spectrum model of the rtd
+      //Ptr<MmWavePhy> rtdPhy = m_rtdDeviceToPhy.find (*netDevIt)->second;
+      //Ptr<MmWavePhy> rtdPhy = m_rtdDeviceToPhy.at (rtdId);
+      //uint32_t rtdId = (*netDevIt)->GetNode()->GetId();
+      //Ptr<MmWavePhy> rtdPhy = m_rtdDeviceToPhy.find (rtdId)->second;
+
+      
+      Ptr<MmWavePhyMacCommon> rtdConfigParam=rtdPhy->GetConfigurationParameters();
+      Ptr<SpectrumModel> rtdSpectrumModel= MmWaveSpectrumValueHelper::GetSpectrumModel(rtdConfigParam);
+      
+      // Verify if the m_rrd and the rtd have the same spectrum model
+      if (rtdSpectrumModel != m_rrd.spectrumModel)
+        {
+          if (rtdSpectrumModel->IsOrthogonal (*m_rrd.spectrumModel))
+            {
+              NS_LOG_WARN ("RTD device is configured to operate on a spectrum "
+                           "that is orthogonal to the one of RRD device. Hence, "
+                           "that RTD device will not be considered in the "
+                           "calculation of this REM map.");
+              continue;
+            }
+          else
+            {
+              NS_LOG_WARN ("RTD device with different spectrum model, this may slow "
+                           "down significantly the REM map creation. Consider setting "
+                           "the same frequency, bandwidth, and numerology to all "
+                           "devices which are used for REM map creation.");
+            }
+        };
+
+      RemDevice rtd;
+      // Configure spectrum model and the configuration parameters which will be needed to create tx PSD
+      rtd.configParam = rtdConfigParam;
+      rtd.spectrumModel = rtdSpectrumModel;
+      // Set the position of the node
+      rtd.mob->SetPosition ((*netDevIt)->GetNode ()->GetObject<MobilityModel> ()->GetPosition ());
+      // Aggregate the MobilityBuildingInfo to the mobility model of the rtd
+      Ptr<MobilityBuildingInfo> buildingInfo = CreateObject<MobilityBuildingInfo> ();
+      rtd.mob->AggregateObject (buildingInfo);
+
+      // Set the antenna of the rtd
+      //rtd.antenna = m_deviceToAntenna.find (*netDevIt)->second;
+      //rtd.antenna = m_deviceToAntenna.find (rtdId)->second;
+      //rtd.antenna = m_deviceToAntenna.at(rtdId);
+      rtd.antenna=rtdAntenna;
+
+      // Use the m_mmwaveBeamformingModelFactory to create a new MmWaveBeamformingModel for the rtd
+      rtd.bfModel = DynamicCast<MmWaveBeamformingModel> (m_mmwaveBeamformingModelFactory.Create());
+      rtd.bfModel->SetDevice(rtd.dev);
+      rtd.bfModel->SetAntenna(rtd.antenna);
+      
+      // Set the transmission power of the rtd
+      if(m_isDl){
+        rtd.txPower = DynamicCast<MmWaveEnbPhy>(rtdPhy)->GetTxPower ();
+      }else{
+        rtd.txPower = DynamicCast<MmWaveUePhy>(rtdPhy)->GetTxPower ();
+      }
+      
+      // Get the numerology and the center frequency to use in the NS_LOG_INFO bellow
+      DoubleValue rtdCenterFreq;
+      rtdConfigParam->GetAttribute ("CenterFreq",rtdCenterFreq);
+      //EnumValue rtdNumerology;
+      //rtdConfigParam->GetAttribute ("Numerology",rtdNumerology);
+
+      NS_LOG_DEBUG ("power of UE: " << rtd.txPower);
+
+      NS_LOG_INFO ("RTD spectrum model: " << rtd.spectrumModel->GetUid () <<
+                   ", RTD number of bands: " << rtd.spectrumModel->GetNumBands () <<
+                   ", create new RTD element... " <<
+                   ", rtdPhy->GetCentralFrequency () " <<
+                   rtdCenterFreq.Get() / 1e6 << " MHz " 
+                   //<<", num: "<< rtdNumerology.Get()
+                   );
+
+      m_remDev.push_back (rtd);
+    }
+  NS_ASSERT_MSG (m_remDev.size (),"No RTD devices configured. Check if the RTD "
+                                  "devices are on the operating on the same "
+                                  "spectrum as RRD device.");
+}
+void
+MmWaveRadioEnvironmentMapHelper::ConfigurePropagationModelsFactories (Ptr<MmWaveSpectrumPhy> txSpectrumPhy)
+{
+  
+  NS_LOG_FUNCTION (this);
+  //Ptr<const MmWaveSpectrumPhy> txSpectrumPhy = rtdPhy->GetSpectrumPhy ();
+  Ptr<SpectrumChannel> txSpectrumChannel = txSpectrumPhy->GetSpectrumChannel ();
+
+  // configure pathloss model factory 
+  m_propagationLossModel = txSpectrumChannel->GetPropagationLossModel ();
+  // configure spectrum model factory 
+  m_spectrumLossModel = txSpectrumChannel->GetSpectrumPropagationLossModel ();
+
+  // configure ChannelConditionModel factory if ThreeGppPropagationLossModel propagation model is being used
+  Ptr<ThreeGppPropagationLossModel> propagationLossModel =  DynamicCast<ThreeGppPropagationLossModel> (txSpectrumChannel->GetPropagationLossModel ());
+  if (propagationLossModel)
+    {
+      Ptr<ChannelConditionModel> channelConditionModel = propagationLossModel->GetChannelConditionModel ();
+      if (channelConditionModel)
+        {
+          m_channelConditionModelFactory = ConfigureObjectFactory (channelConditionModel);
+        }
+      else
+        {
+          NS_FATAL_ERROR ("ThreeGppPropagationLossModel does not have configured ChannelConditionModel");
+        }
+    }
+  else
+    {
+      NS_LOG_WARN ("RemHelper currently only knows that ThreeGppPropagationLossModel can have ChannelConditionModel. Other models do not support it yet.");
+    }
+
+  // configure ThreeGppChannelModel (MatrixBasedChannelModel) factory if spectrumLossModel is ThreeGppSpectrumPropagationLossModel
+  Ptr<ThreeGppSpectrumPropagationLossModel> spectrumLossModel = DynamicCast<ThreeGppSpectrumPropagationLossModel> (txSpectrumChannel->GetSpectrumPropagationLossModel ());
+  if (spectrumLossModel)
+    {
+      if (spectrumLossModel->GetChannelModel ())
+        {
+          m_matrixBasedChannelModelFactory = ConfigureObjectFactory (spectrumLossModel->GetChannelModel ());
+        }
+      else
+        {
+          NS_FATAL_ERROR ("ThreeGppSpectrumPropagationLossModel does not have configured MatrixBasedChannelModel");
+        }
+    }
+  else
+    {
+      NS_LOG_WARN ("RemHelper currently only knows that ThreeGppSpectrumPropagationLossModel can have MatrixBasedChannelModel. Other models do not support it yet.");
+    }
+}
