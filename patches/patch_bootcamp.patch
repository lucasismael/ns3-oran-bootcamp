+  //std::vector<Ptr<MmWavePhy>> m_rtdDeviceToPhy;
+  //std::vector<Ptr<ThreeGppAntennaArrayModel>> m_deviceToAntenna;
+  //std::map <const uint32_t, Ptr<MmWavePhy>> m_rtdDeviceToPhy;     //< Map for storing the phy of each RTD device
+  //std::map <const uint32_t, Ptr<ThreeGppAntennaArrayModel>> m_deviceToAntenna; //< Map for storing the phy of each device
+  //std::vector <const uint32_t, Ptr<MmWavePhy>> m_rtdDeviceToPhy;     //< Map for storing the phy of each RTD device
+  //std::vector <const uint32_t, Ptr<ThreeGppAntennaArrayModel>> m_deviceToAntenna; //< Map for storing the phy of each device
+  //std::vector<std::pair<uint32_t,Ptr<MmWavePhy>>> m_rtdDeviceToPhy;
