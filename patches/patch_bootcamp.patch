+++ b/src/applications/model/udp-poisson-server.cc
@@ -0,0 +1,210 @@
+/* -*- Mode:C++; c-file-style:"gnu"; indent-tabs-mode:nil; -*- */
+/*
+ *  Copyright (c) 2007,2008,2009 INRIA, UDCAST
+ *
