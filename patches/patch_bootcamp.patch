+/* -*- Mode:C++; c-file-style:"gnu"; indent-tabs-mode:nil; -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation;
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+
+/**
+ * @file mab-agent.cc
+ * @brief Implementation of the epsilon-greedy Multi-Armed Bandit (MAB) agent
+ *        for MR-DC downlink traffic split ratio control.
+ *
+ * @see mab-agent.h for the full class and algorithm description.
+ */
+
+#include "mab-agent.h"
+#include "ns3/log.h"
+#include "ns3/double.h"
+#include "ns3/uinteger.h"
+#include <algorithm>
+
+namespace ns3{
+
+NS_LOG_COMPONENT_DEFINE ("MabAgent");
+NS_OBJECT_ENSURE_REGISTERED (MabAgent);
+
+TypeId
+MabAgent::GetTypeId (void)
+{
+  static TypeId tid = TypeId ("ns3::MabAgent")
+    .SetParent<Object> ()
+    .SetGroupName ("Network")
+    .AddConstructor<MabAgent> ()
+    .AddAttribute ("Epsilon",
+                   "Initial exploration probability ε ∈ [0, 1].  "
+                   "Decays exponentially each decision step by DecayFactor "
+                   "until EpsilonMin is reached.",
+                   DoubleValue (0.1),
+                   MakeDoubleAccessor (&MabAgent::m_epsilon),
+                   MakeDoubleChecker<double> (0.0, 1.0))
+    .AddAttribute ("EpsilonMin",
+                   "Minimum value of ε after exponential decay.",
+                   DoubleValue (0.01),
+                   MakeDoubleAccessor (&MabAgent::m_epsilonMin),
+                   MakeDoubleChecker<double> (0.0, 1.0))
+    .AddAttribute ("DecayFactor",
+                   "Multiplicative factor applied to ε each decision step "
+                   "(1.0 = no decay, i.e., stationary exploration rate).",
+                   DoubleValue (1.0),
+                   MakeDoubleAccessor (&MabAgent::m_decayFactor),
+                   MakeDoubleChecker<double> (0.0, 1.0))
+    .AddAttribute ("LearningRate",
+                   "Step-size parameter α for incremental Q-value updates.  "
+                   "Set to 0 to use the sample-mean rule (α = 1/N(a)).",
+                   DoubleValue (0.1),
+                   MakeDoubleAccessor (&MabAgent::m_learningRate),
+                   MakeDoubleChecker<double> (0.0, 1.0))
+    .AddAttribute ("InitialQValue",
+                   "Optimistic initial Q-value assigned to all arms at "
+                   "construction and after each ResetLearning() call.  "
+                   "A large value drives systematic exploration of all arms "
+                   "before the agent settles on the best split ratio.",
+                   DoubleValue (1000000.0),
+                   MakeDoubleAccessor (&MabAgent::m_initialQ),
+                   MakeDoubleChecker<double> ());
+  return tid;
+}
+
+MabAgent::MabAgent ()
+  : m_nArms (0),
+    m_lastAction (-1)
+{
+  m_rng = CreateObject<UniformRandomVariable> ();
+}
+
+MabAgent::~MabAgent () {}
+
+void
+MabAgent::SetNumberOfArms (uint32_t nArms)
+{
+  m_nArms = nArms;
+  m_qValues.assign (nArms, m_initialQ);
+  m_actionCounts.assign (nArms, 0);
+}
+
+void
+MabAgent::SetStream (int64_t streamId)
+{
+  m_rng->SetStream (streamId);
+}
+
+uint32_t
+MabAgent::SelectAction (void)
+{
+  if (m_nArms == 0) return 0; // Fallback: no arms configured
+
+  // Apply exponential epsilon decay before the decision
+  if (m_epsilon > m_epsilonMin)
+    {
+      m_epsilon *= m_decayFactor;
+      if (m_epsilon < m_epsilonMin)
+        {
+          m_epsilon = m_epsilonMin;
+        }
+    }
+
+  if (m_rng->GetValue () < m_epsilon)
+    {
+      // Exploration: select a uniformly random arm
+      m_lastAction = m_rng->GetInteger (0, m_nArms - 1);
+    }
+  else
+    {
+      // Exploitation: select the arm with the highest Q-value
+      m_lastAction = FindGreedyAction ();
+    }
+
+  return m_lastAction;
+}
+
+uint32_t
+MabAgent::FindGreedyAction (void) const
+{
+  auto it = std::max_element (m_qValues.begin (), m_qValues.end ());
+  return std::distance (m_qValues.begin (), it);
+}
+
+void
+MabAgent::UpdateLastAction (double reward)
+{
+  if (m_lastAction >= m_nArms) return;
+
+  m_actionCounts[m_lastAction]++;
+  double oldQ  = m_qValues[m_lastAction];
+  // Use configured alpha, or fall back to sample-mean rule (1/N(a)) if alpha = 0
+  double alpha = (m_learningRate > 0) ? m_learningRate
+                                      : (1.0 / m_actionCounts[m_lastAction]);
+
+  m_qValues[m_lastAction] = oldQ + alpha * (reward - oldQ);
+}
+
+void
+MabAgent::ResetLearning (double resetEpsilon, double newTargetMbb, double newTargetXr)
+{
+  m_targetMbb = newTargetMbb;
+  m_targetXr  = newTargetXr;
+  m_epsilon   = resetEpsilon;
+
+  // Reset Q-values to the optimistic initial value to trigger re-exploration
+  m_qValues.assign (m_nArms, m_initialQ);
+  m_actionCounts.assign (m_nArms, 0);
+
+  m_lastAction = -1;
+}
+
+void
+MabAgent::SetTargets (double targetMbb, double targetXr)
+{
+  m_targetMbb = targetMbb;
+  m_targetXr  = targetXr;
+}
+
+double MabAgent::GetTargetMbb ()       const { return m_targetMbb; }
+double MabAgent::GetTargetXr ()        const { return m_targetXr;  }
+std::vector<double>   MabAgent::GetQValues ()      const { return m_qValues; }
+std::vector<uint32_t> MabAgent::GetActionCounts () const { return m_actionCounts; }
+double MabAgent::GetEpsilon ()         const { return m_epsilon; }
+
+} // namespace ns3
