+void MmWaveMcRadioEnvironmentMapHelper::CalcCoverageAreaRem(){
+	NS_LOG_FUNCTION (this);
+	
+	// Number of iterations
+	uint16_t numIter=10; 
+	
+	std::list<RemPoint> remPointList;
+	
+	// The number of rtds
+	uint8_t nRtds=m_rtd.size();
+	
+	// Set the variables used to show the rem progress
+	uint16_t j=0;
+	uint16_t remSize=m_rem.size();	
+	
+	// Calculate the SNR and SINR values for each RemPoint
+	for (auto itRemPoint:m_rem){
+		
+		// Create a "device" to the remPoint with the same configuration as the m_rrd
+		MmWaveRemDevice rpd = m_rrd;
+		
+		// Create a list to hold a copy of the m_rtd, in order to be able to modify the beamforming vectors
+		std::list<MmWaveRemDevice> rtd;
+		
+		// Set the position of the rpd to be the same as the RemPoint
+		rpd.mob->SetPosition (itRemPoint.pos);
+		
+		// Create the variables that will save the sum of the snr and sinr for the average
+		double sumSnr=0;
+		double sumSinr=0;
+		std::vector<double> sumSnrPerRtd(nRtds);
+		std::vector<double> sumSinrPerRtd(nRtds);
+		
+		// Point all the rtds to that specific rem point and initialize the sumPerRtd vectors
+		for(auto itRtd:m_rtd){
+			ConfigureBeamformingVectors(itRtd,rpd);
+			rtd.push_back(itRtd);
+			
+			sumSnrPerRtd.push_back(0);
+			sumSinrPerRtd.push_back(0);
+		}	
+			
+		
+		// Do the calculations for each iteraction
+		for(uint16_t iter=0; iter<numIter; ++iter){
+			
+			// Lists to save the SINR and the SNR per RTD
+			std::list<double> sinrsPerRtd;
+			std::list<double> snrsPerRtd;
+			
+			// Create the variables to keep the interference and the useful signals
+			std::list<Ptr<SpectrumValue>> interferenceSignalsRxPsds;
+			
+			// For each RTD, calculate the received power
+			uint8_t i=0;
+			for(auto itRtd:rtd){
+				ConfigureBeamformingVectors(rpd, itRtd);
+				
+				// Calculate the rxPsd from the RTD to the specific Rem Point
+				Ptr<SpectrumValue> rxPsd=CalcRxPsdValue(itRtd,rpd);
+				
+				// Calculate the SNR
+				double snr=CalculateSnr (rxPsd);
+				snrsPerRtd.push_back (snr);	
+				
+				
+				// Calculate the interference caused by each rtd
+				for(auto itRtdInter:rtd){
+					if(itRtdInter.node!=itRtd.node){
+						// Calculate and store the intereference power
+						Ptr<SpectrumValue> rxPsdInter=CalcRxPsdValue(itRtdInter,rpd);
+						interferenceSignalsRxPsds.push_back(rxPsdInter);
+					}
+				}
+				
+				// Calculate the SINR
+				double sinr=CalculateSinr (rxPsd,interferenceSignalsRxPsds);
+				sinrsPerRtd.push_back (sinr);
+				
+				// Save the SNR and the SINR per RTD
+				sumSnrPerRtd[i]+=snr;
+				sumSinrPerRtd[i]+=sinr;
+				
+				++i;
+				
+			}
+			sumSnr += GetMaxValue (snrsPerRtd);
+			sumSinr += GetMaxValue (sinrsPerRtd);
+			
+		}
+		itRemPoint.avgSnrDb = sumSnr / static_cast <double> (numIter);
+		itRemPoint.avgSinrDb = sumSinr / static_cast <double> (numIter);
+		
+		NS_LOG_INFO ("RemPoint " <<itRemPoint.pos<<": SNR = "<< itRemPoint.avgSnrDb << ", SINR= "<<itRemPoint.avgSinrDb);
+		
+		// Averaging the sums per RTD 
+		for(uint8_t i=0;i<nRtds;++i){
+			sumSnrPerRtd[i]=sumSnrPerRtd[i]/ static_cast <double> (numIter);
+			sumSinrPerRtd[i]=sumSinrPerRtd[i]/ static_cast <double> (numIter);;	
+		}
+		
+		itRemPoint.avgSnrPerRtd = sumSnrPerRtd;
+		itRemPoint.avgSinrPerRtd = sumSinrPerRtd;
+		
+		remPointList.push_back(itRemPoint);
+		double progress = (j*100)/remSize ;
+		NS_LOG_INFO ("Done: " << progress << " %.");
+		++j;
+	}
+	m_rem=remPointList;
+}
