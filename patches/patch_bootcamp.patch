diff --git a/src/lte/model/ue-throughput-storage.h b/src/lte/model/ue-throughput-storage.h
new file mode 100644
index 00000000..f368b102
--- /dev/null
+++ b/src/lte/model/ue-throughput-storage.h
@@ -0,0 +1,254 @@
+#ifndef UE_THROUGHPUT_STORAGE_H
+#define UE_THROUGHPUT_STORAGE_H
+
+/**
+ * @file ue-throughput-storage.h
+ * @brief Global static storage for per-UE, per-DRB throughput and delay
+ *        measurements in an MR-DC (Multi-Radio Dual Connectivity) simulation.
+ *
+ * UeThroughputStorage provides a lightweight, simulation-wide key-value store
+ * that accumulates LTE and NR (mmWave) throughput and one-way delay samples
+ * indexed by the composite key @c <IMSI, DRB-ID>.  The stored values are
+ * consumed by the O-RAN indication-message helpers to populate E2SM-KPM PM
+ * containers and by the MAB-based split-ratio xApp running on the Near-RT RIC.
+ */
+
+#include <map>
+#include <cstdint>
+#include <tuple>
+#include <numeric>
+#include <algorithm>
+
+namespace ns3 {
+
+/**
+ * @brief Composite key type identifying a bearer by UE and DRB.
+ *
+ * The first element is the UE's 64-bit IMSI; the second element is the
+ * 8-bit Data Radio Bearer (DRB) identifier.
+ */
+using DrbKey = std::tuple<uint64_t, uint8_t>;
+
+/**
+ * @brief Simulation-wide static store for per-DRB throughput and delay KPIs.
+ *
+ * All members are static, making UeThroughputStorage a singleton-style
+ * repository accessible from any simulation module without requiring an
+ * ns-3 object reference.  The store must be Reset() at the beginning of
+ * each measurement reporting interval to avoid accumulation across periods.
+ *
+ * In an EN-DC (E-UTRA--NR Dual Connectivity) scenario a single DRB may have
+ * entries in both the LTE and NR throughput maps simultaneously, reflecting
+ * the split traffic on each radio leg.
+ */
+class UeThroughputStorage {
+public:
+    /**
+     * @brief Per-DRB LTE-leg throughput map (kbps), indexed by @c <IMSI, DRB-ID>.
+     *
+     * In an EN-DC deployment a DRB may have a simultaneous entry in
+     * @c m_nrThroughputPerDrb when traffic is split across both radio legs.
+     */
+    static std::map<DrbKey, double> m_lteThroughputPerDrb;
+
+    /**
+     * @brief Per-DRB LTE-leg one-way packet delay map (ms),
+     *        indexed by @c <IMSI, DRB-ID>.
+     */
+    static std::map<DrbKey, double> m_lteDelayPerDrb;
+
+    /**
+     * @brief Per-DRB NR-leg throughput map (kbps), indexed by @c <IMSI, DRB-ID>.
+     */
+    static std::map<DrbKey, double> m_nrThroughputPerDrb;
+
+    /**
+     * @brief Per-DRB NR-leg one-way packet delay map (ms),
+     *        indexed by @c <IMSI, DRB-ID>.
+     */
+    static std::map<DrbKey, double> m_nrDelayPerDrb;
+
+    /**
+     * @brief Mapping from @c <IMSI, DRB-ID> to QoS Class Identifier (QCI).
+     */
+    static std::map<DrbKey, uint64_t> m_drb2QciMap;
+
+    /**
+     * @brief Sets the QCI for a specific DRB of a given UE.
+     *
+     * @param imsi   64-bit International Mobile Subscriber Identity of the UE.
+     * @param drbId  8-bit Data Radio Bearer identifier.
+     * @param qci    QoS Class Identifier to associate with this bearer.
+     */
+    static void SetDrbQci(uint64_t imsi, uint8_t drbId, uint64_t qci) {
+        m_drb2QciMap[std::make_tuple(imsi, drbId)] = qci;
+    }
+
+    /**
+     * @brief Returns the QCI for a specific DRB of a given UE.
+     *
+     * @param imsi   64-bit IMSI of the UE.
+     * @param drbId  8-bit DRB identifier.
+     * @return The QCI associated with the bearer, or @c 0 if no entry exists.
+     */
+    static uint64_t GetDrbQci(uint64_t imsi, uint8_t drbId) {
+        DrbKey key = std::make_tuple(imsi, drbId);
+        return m_drb2QciMap.count(key) ? m_drb2QciMap[key] : 0;
+    }
+
+    /**
+     * @brief Sets the LTE-leg throughput for a specific DRB of a given UE.
+     *
+     * @param imsi        64-bit IMSI of the UE.
+     * @param drbId       8-bit DRB identifier.
+     * @param throughput  LTE-leg throughput (kbps) measured during the current
+     *                    reporting interval.
+     */
+    static void SetLteThroughput(uint64_t imsi, uint8_t drbId, double throughput) {
+        m_lteThroughputPerDrb[std::make_tuple(imsi, drbId)] = throughput;
+    }
+
+    /**
+     * @brief Sets the LTE-leg one-way packet delay for a specific DRB of a given UE.
+     *
+     * @param imsi   64-bit IMSI of the UE.
+     * @param drbId  8-bit DRB identifier.
+     * @param delay  LTE-leg one-way packet delay (ms).
+     */
+    static void SetLteDelay(uint64_t imsi, uint8_t drbId, double delay) {
+        m_lteDelayPerDrb[std::make_tuple(imsi, drbId)] = delay;
+    }
+
+    /**
+     * @brief Sets the NR (mmWave) leg throughput for a specific DRB of a given UE.
+     *
+     * @param imsi        64-bit IMSI of the UE.
+     * @param drbId       8-bit DRB identifier.
+     * @param throughput  NR-leg throughput (kbps) measured during the current
+     *                    reporting interval.
+     */
+    static void SetNrThroughput(uint64_t imsi, uint8_t drbId, double throughput) {
+        m_nrThroughputPerDrb[std::make_tuple(imsi, drbId)] = throughput;
+    }
+
+    /**
+     * @brief Sets the NR (mmWave) leg one-way packet delay for a specific DRB of a given UE.
+     *
+     * @param imsi   64-bit IMSI of the UE.
+     * @param drbId  8-bit DRB identifier.
+     * @param delay  NR-leg one-way packet delay (ms).
+     */
+    static void SetNrDelay(uint64_t imsi, uint8_t drbId, double delay) {
+        m_nrDelayPerDrb[std::make_tuple(imsi, drbId)] = delay;
+    }
+
+    /**
+     * @brief Returns the LTE-leg throughput for a specific DRB of a given UE.
+     *
+     * @param imsi   64-bit IMSI of the UE.
+     * @param drbId  8-bit DRB identifier.
+     * @return LTE-leg throughput (kbps), or @c 0.0 if no entry exists.
+     */
+    static double GetLteThroughput(uint64_t imsi, uint8_t drbId) {
+        DrbKey key = std::make_tuple(imsi, drbId);
+        return m_lteThroughputPerDrb.count(key) ? m_lteThroughputPerDrb[key] : 0.0;
+    }
+
+    /**
+     * @brief Returns the NR-leg throughput for a specific DRB of a given UE.
+     *
+     * @param imsi   64-bit IMSI of the UE.
+     * @param drbId  8-bit DRB identifier.
+     * @return NR-leg throughput (kbps), or @c 0.0 if no entry exists.
+     */
+    static double GetNrThroughput(uint64_t imsi, uint8_t drbId) {
+        DrbKey key = std::make_tuple(imsi, drbId);
+        return m_nrThroughputPerDrb.count(key) ? m_nrThroughputPerDrb[key] : 0.0;
+    }
+
+    /**
+     * @brief Returns the LTE-leg one-way packet delay for a specific DRB of a given UE.
+     *
+     * @param imsi   64-bit IMSI of the UE.
+     * @param drbId  8-bit DRB identifier.
+     * @return LTE-leg one-way packet delay (ms), or @c 0.0 if no entry exists.
+     */
+    static double GetLteDelay(uint64_t imsi, uint8_t drbId) {
+        DrbKey key = std::make_tuple(imsi, drbId);
+        return m_lteDelayPerDrb.count(key) ? m_lteDelayPerDrb[key] : 0.0;
+    }
+
+    /**
+     * @brief Returns the NR-leg one-way packet delay for a specific DRB of a given UE.
+     *
+     * @param imsi   64-bit IMSI of the UE.
+     * @param drbId  8-bit DRB identifier.
+     * @return NR-leg one-way packet delay (ms), or @c 0.0 if no entry exists.
+     */
+    static double GetNrDelay(uint64_t imsi, uint8_t drbId) {
+        DrbKey key = std::make_tuple(imsi, drbId);
+        return m_nrDelayPerDrb.count(key) ? m_nrDelayPerDrb[key] : 0.0;
+    }
+
+    /**
+     * @brief Computes the aggregated (LTE + NR) throughput for a specific DRB.
+     *
+     * Returns the sum of the LTE-leg and NR-leg throughputs for the given
+     * bearer, reflecting the total goodput delivered to the UE via both
+     * radio legs in an MR-DC configuration.
+     *
+     * @param imsi   64-bit IMSI of the UE.
+     * @param drbId  8-bit DRB identifier.
+     * @return Aggregated throughput (kbps) across both radio legs.
+     */
+    static double GetAggregatedThroughput(uint64_t imsi, uint8_t drbId) {
+        return GetLteThroughput(imsi, drbId) + GetNrThroughput(imsi, drbId);
+    }
+
+    /**
+     * @brief Computes the total throughput across all DRBs for a given UE.
+     *
+     * Iterates over all entries in both the LTE and NR throughput maps and
+     * @brief Returns the total downlink throughput across all DRBs for a UE.
+     *
+     * Sums LTE and NR contributions over all registered DRBs for the given IMSI.
+     *
+     * @param imsi UE IMSI.
+     * @return Total throughput [kbps] across all DRBs and both radio legs.
+     */
+    static double GetUeTotalThroughput(uint64_t imsi) {
+        double total = 0.0;
+
+        for (const auto& pair : m_lteThroughputPerDrb) {
+            if (std::get<0>(pair.first) == imsi) {
+                total += pair.second;
+            }
+        }
+
+        for (const auto& pair : m_nrThroughputPerDrb) {
+            if (std::get<0>(pair.first) == imsi) {
+                total += pair.second;
+            }
+        }
+
+        return total;
+    }
+
+    /**
+     * @brief Clears all stored measurements for the next accumulation window.
+     *
+     * Must be called at the beginning of each E2 indication period to prevent
+     * stale measurements from polluting the reward computation.
+     */
+    static void Reset() {
+        m_lteThroughputPerDrb.clear();
+        m_lteDelayPerDrb.clear();
+        m_nrThroughputPerDrb.clear();
+        m_nrDelayPerDrb.clear();
+        m_drb2QciMap.clear();
+    }
+};
+
+} // namespace ns3
+
+#endif /* UE_THROUGHPUT_STORAGE_H */
